<ui:FluentWindow x:Class="Grex365.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Grex365.App.ViewModels"
        xmlns:local="clr-namespace:Grex365.App"
        xmlns:l="clr-namespace:Grex365.App.Xaml"
        xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
        mc:Ignorable="d"
        Title="GREX365"
        Icon="pack://application:,,,/Assets/Grex365.ico"
        Height="820" Width="1320"
        MinHeight="640" MinWidth="1100"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseUserDrawerCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenAboutCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLogPanelCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateToIndexCommand}" CommandParameter="9" />
    </ui:FluentWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GREX365 · Microsoft 365 toolkit">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Grex365.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SidebarBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,20,16,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource GxLogoMark}"
                                            Width="22" Height="22"
                                            Margin="0,1,11,0"
                                            VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GREX365"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontFamily="Cascadia Mono, Consolas">
                                    <Run Text="v" /><Run Text="{x:Static local:App.AppVersion}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="10,8,10,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="{l:L10n Key=Shell.Sidebar.Theme}"
                                       Margin="0,0,6,0"
                                       ToolTip="{l:L10n Key=Shell.Sidebar.Theme.Tooltip}"
                                       Command="{Binding ToggleThemeCommand}" />
                            <ui:Button Grid.Column="1"
                                       Content="{l:L10n Key=Shell.Sidebar.Settings}"
                                       HorizontalAlignment="Stretch"
                                       ToolTip="{l:L10n Key=Shell.Sidebar.Settings.Tooltip}"
                                       Command="{Binding OpenSettingsCommand}" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top"
                            Height="1"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Margin="0,0,0,6" />

                    <ListBox ItemsSource="{Binding NavigationItemsView}"
                             SelectedItem="{Binding SelectedNavigation}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="14,14,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Glyph}"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BrushSemanticError}"
                                            CornerRadius="9"
                                            MinWidth="18"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="6,0,2,0"
                                            Visibility="{Binding HasErrorBadge, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <TextBlock Text="{Binding ErrorBadge}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="3*" />
                                <Setter Property="MinHeight" Value="280" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogPanelVisible}" Value="False">
                                        <Setter Property="Height" Value="*" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogPanelVisible}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="*" />
                                <Setter Property="MinHeight" Value="120" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogPanelVisible}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <!-- Transición en CADA navegación: Binding.TargetUpdated dispara al cambiar
                     CurrentPage (el Loaded del template anterior solo disparaba la primera vez —
                     las páginas son singleton y el template no se recarga). Fade + slide-up. -->
                <ContentControl Grid.Row="0"
                                Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform Y="0" />
                    </ContentControl.RenderTransform>
                    <ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="14" To="0"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ContentControl.Triggers>
                </ContentControl>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              ShowsPreview="True"
                              Margin="24,0,24,0"
                              Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Border Width="40" Height="3" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    Opacity="0.7" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="SizeNS" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Border Grid.Row="2"
                        Margin="24,0,24,16"
                        Style="{StaticResource Card}"
                        Padding="0"
                        Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,12,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text=""
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           Opacity="0.85"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{l:L10n Key=Shell.Log.Title}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center">
                                <CheckBox Content="{l:L10n Key=Shell.Log.Filter.Info}" IsChecked="{Binding ShowInfo}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:L10n Key=Shell.Log.Filter.Ok}"   IsChecked="{Binding ShowOk}"   Margin="0,0,10,0" />
                                <CheckBox Content="{l:L10n Key=Shell.Log.Filter.Warn}" IsChecked="{Binding ShowWarn}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:L10n Key=Shell.Log.Filter.Err}"  IsChecked="{Binding ShowError}" Margin="0,0,10,0" />
                                <CheckBox Content="{l:L10n Key=Shell.Log.Filter.Dbg}"  IsChecked="{Binding ShowDebug}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Content="{l:L10n Key=Shell.Log.Button.Export}"
                                           Margin="0,0,8,0"
                                           ToolTip="{l:L10n Key=Shell.Log.Button.Export.Tooltip}"
                                           Command="{Binding ExportLogCommand}" />
                                <ui:Button Content="{l:L10n Key=Shell.Log.Button.Clear}"
                                           Icon=""
                                           Command="{Binding ClearLogCommand}" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="GlobalLogList"
                                 ItemsSource="{Binding LogView}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,0,8,8"
                                 SelectionMode="Extended"
                                 PreviewKeyDown="GlobalLogList_PreviewKeyDown"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                    <Grid Margin="8,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Cascadia Mono,Consolas"
                                                   FontSize="11" />
                                        <Border Grid.Column="1"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"
                                                Opacity="0.18" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Severity}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Margin="6,1,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Source}"
                                                   Opacity="0.8"
                                                   FontSize="12" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource StatusBarSurface}">
            <Grid Margin="16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}" />
                    <TextBlock Text="{l:L10n Key=Shell.Status.Graph}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}" />
                    <TextBlock Text="{l:L10n Key=Shell.Status.Exchange}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="2" Width="1" Margin="0,4,16,4"
                           Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12">
                    <Run Text="{l:L10n Key=Shell.Status.Tenant}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding TenantDomain, FallbackValue=—}" />
                </TextBlock>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12">
                    <Run Text="{l:L10n Key=Shell.Status.Account}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding Account, FallbackValue=—}" />
                </TextBlock>

                <TextBlock Grid.Column="5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,16,0">
                    <Run Text="GREX365 · v" /><Run Text="{x:Static local:App.AppVersion}" />
                </TextBlock>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <ui:Button Content="{l:L10n Key=Shell.Status.Button.About}"
                               Margin="0,0,8,0"
                               Command="{Binding OpenAboutCommand}"
                               ToolTip="{l:L10n Key=Shell.Status.Button.About.Tooltip}" />
                    <ui:Button Content="{l:L10n Key=Shell.Status.Button.Log}"
                               Margin="0,0,8,0"
                               Command="{Binding ToggleLogPanelCommand}"
                               ToolTip="{l:L10n Key=Shell.Status.Button.Log.Tooltip}" />
                    <ui:Button Content="{l:L10n Key=Shell.Status.Button.Disconnect}"
                               Icon=""
                               Command="{Binding DisconnectAllCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.Row="0"
                              Grid.RowSpan="3"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,16,24" />

        <!-- Scrim: click fuera del drawer lo cierra (patrón overlay estándar). Solo
             intercepta input mientras el drawer está abierto. -->
        <Border Grid.Row="1"
                Background="#28000000"
                Panel.ZIndex="998"
                Visibility="{Binding UserDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseUserDrawerCommand}" />
            </Border.InputBindings>
        </Border>

        <!-- User details drawer overlay (animated slide-in from right) -->
        <Border Grid.Row="1"
                Width="460"
                HorizontalAlignment="Right"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Panel.ZIndex="999"
                IsHitTestVisible="{Binding UserDrawerOpen}">
            <Border.RenderTransform>
                <TranslateTransform X="460" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UserDrawerOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="460" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentControl Content="{Binding UserDetailsVm}" />
        </Border>
    </Grid>
</ui:FluentWindow>
