<ui:FluentWindow x:Class="Grex365.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Grex365.App.ViewModels"
        xmlns:l="clr-namespace:Grex365.App.Xaml"
        mc:Ignorable="d"
        Title="{l:L10n Key=Settings.Window.Title}"
        Height="640" Width="720"
        MinHeight="480" MinWidth="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:L10n Key=Settings.TitleBar}" />

        <ScrollViewer Grid.Row="1" Margin="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{l:L10n Key=Settings.Preferences}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{l:L10n Key=Settings.Section.Connection}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox SelectedValue="{Binding ConnectionMethod}"
                                  SelectedValuePath="Tag"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="{l:L10n Key=Settings.Connection.Cert}" Tag="cert" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.Connection.Traditional}" Tag="traditional" />
                        </ComboBox>

                        <TextBlock Text="{l:L10n Key=Settings.Tenant.IdLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding ExpectedTenantId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=Settings.Tenant.IdPlaceholder}"
                                    Margin="0,0,0,12" />

                        <TextBlock Text="{l:L10n Key=Settings.Tenant.DomainLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding ExpectedTenantDomain, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=Settings.Tenant.DomainPlaceholder}"
                                    Margin="0,0,0,12" />

                        <CheckBox Content="{l:L10n Key=Settings.EnforceTenantLock}"
                                  IsChecked="{Binding EnforceTenantLock}" />

                        <TextBlock Text="{l:L10n Key=Settings.LanguageLabel}" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ComboBox SelectedValue="{Binding Language}"
                                  SelectedValuePath="Tag"
                                  Width="220"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="{l:L10n Key=Settings.Language.Spanish}" Tag="es" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.Language.English}" Tag="en" />
                        </ComboBox>
                        <TextBlock Text="{Binding LanguageRestartHint}"
                                   Opacity="0.85"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{l:L10n Key=Settings.Theme}" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ComboBox SelectedValue="{Binding Theme}"
                                  SelectedValuePath="Tag"
                                  Width="220"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="{l:L10n Key=Settings.Theme.Dark}" Tag="Dark" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.Theme.Light}" Tag="Light" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.Theme.Auto}" Tag="Auto" />
                        </ComboBox>
                        <TextBlock Text="{l:L10n Key=Settings.Theme.Hint}"
                                   Opacity="0.55" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{l:L10n Key=Settings.LogLevel}" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ComboBox SelectedValue="{Binding LogLevel}"
                                  SelectedValuePath="Tag"
                                  Width="200"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="{l:L10n Key=Settings.LogLevel.Debug}" Tag="Debug" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.LogLevel.Information}" Tag="Information" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.LogLevel.Warning}" Tag="Warning" />
                            <ComboBoxItem Content="{l:L10n Key=Settings.LogLevel.Error}" Tag="Error" />
                        </ComboBox>
                        <TextBlock Text="{l:L10n Key=Settings.LogLevel.Hint}"
                                   Opacity="0.55"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <TextBlock Text="{l:L10n Key=Settings.AppInsights}" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ui:TextBox Text="{Binding ApplicationInsightsConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=Settings.AppInsights.Placeholder}"
                                    Margin="0,0,0,4" />
                        <TextBlock Text="{l:L10n Key=Settings.AppInsights.Hint}"
                                   Opacity="0.55"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{l:L10n Key=Settings.Rbac}" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ui:TextBox Text="{Binding AuthorizationGroupId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=Settings.Tenant.IdPlaceholder}"
                                    Margin="0,0,0,4" />
                        <TextBlock Text="{l:L10n Key=Settings.Rbac.Hint}"
                                   Opacity="0.55"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:L10n Key=Settings.Section.Plugins}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{l:L10n Key=Settings.Plugins.Hint}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding AssemblyFileName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Status}" Opacity="0.65" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ModuleCountLabel}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:L10n Key=Settings.Plugins.Empty}"
                                   Opacity="0.55"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:L10n Key=Settings.Section.Certificate}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{l:L10n Key=Settings.Cert.AppId}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CertAppId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{l:L10n Key=Settings.Cert.TenantId}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CertTenantId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{l:L10n Key=Settings.Cert.Organization}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CertOrganization, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{l:L10n Key=Settings.Cert.Thumbprint}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding CertThumbprint, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1"
                                       Content="{l:L10n Key=Settings.Cert.Browse}"
                                       Margin="8,0,0,0"
                                       Click="BrowseCert_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button Content="{l:L10n Key=Settings.Cert.Validate}"
                                       Margin="0,0,8,0"
                                       Command="{Binding ValidateCertCommand}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding CertStatusMessage}"
                                       Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding SaveStatus}"
                           Opacity="0.8"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <ui:Button Content="{l:L10n Key=Settings.Button.Reload}"
                           Margin="0,0,8,0"
                           Command="{Binding LoadCommand}" />
                <ui:Button Content="{l:L10n Key=Settings.Button.Save}"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
