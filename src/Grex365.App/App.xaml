<Application x:Class="Grex365.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Grex365.App.Converters"
             xmlns:vm="clr-namespace:Grex365.App.ViewModels"
             xmlns:v="clr-namespace:Grex365.App.Views"
             xmlns:local="clr-namespace:Grex365.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 GREX365 — Futurista palette (Sprint L visual overhaul)
                 Premium minimalist tech UI. Glass surfaces + accent glow.
                 Override de tokens wpf-ui (AccentFill*) + nuevos custom.
                 ============================================================ -->

            <!-- Brand accent gradient (azul eléctrico → púrpura) — coherente light+dark -->
            <Color x:Key="BrandAccentStart">#5B8DEF</Color>
            <Color x:Key="BrandAccentMid">#7A78F0</Color>
            <Color x:Key="BrandAccentEnd">#A66CF4</Color>
            <Color x:Key="BrandAccentGlow">#665B8DEF</Color>
            <Color x:Key="BrandCyan">#7AB7FF</Color>
            <Color x:Key="BrandPurple">#B79DFB</Color>

            <SolidColorBrush x:Key="BrandAccentSolid" Color="{StaticResource BrandAccentStart}" />
            <SolidColorBrush x:Key="BrandAccentPurple" Color="{StaticResource BrandAccentEnd}" />
            <SolidColorBrush x:Key="BrandAccentCyan" Color="{StaticResource BrandCyan}" />

            <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource BrandAccentStart}" Offset="0" />
                <GradientStop Color="{StaticResource BrandAccentMid}" Offset="0.55" />
                <GradientStop Color="{StaticResource BrandAccentEnd}" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrandAccentGradientSoft" StartPoint="0,0" EndPoint="1,1" Opacity="0.18">
                <GradientStop Color="{StaticResource BrandAccentStart}" Offset="0" />
                <GradientStop Color="{StaticResource BrandAccentEnd}" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrandAccentGradientVertical" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource BrandAccentStart}" Offset="0" />
                <GradientStop Color="{StaticResource BrandAccentEnd}" Offset="1" />
            </LinearGradientBrush>

            <!-- Override wpf-ui accent for whole app (Buttons Primary, selected items, etc.) -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource BrandAccentStart}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource BrandAccentMid}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource BrandAccentEnd}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource BrandAccentStart}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource BrandAccentMid}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource BrandAccentEnd}" />

            <!-- Glass surfaces (semi-transparent over Mica backdrop) -->
            <Color x:Key="GlassSurfaceDark">#A6161C28</Color>
            <Color x:Key="GlassSurfaceDarkElevated">#CC1B2230</Color>
            <Color x:Key="GlassSurfaceLight">#CCFFFFFF</Color>
            <Color x:Key="GlassSurfaceLightElevated">#EEFAFBFE</Color>

            <!-- Border highlight gradient (subtle iluminated edge) -->
            <LinearGradientBrush x:Key="GlassBorderHighlight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#664F8CFF" Offset="0" />
                <GradientStop Color="#229B6CFF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GlassBorderSubtle" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#33FFFFFF" Offset="0" />
                <GradientStop Color="#11FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- Accent glow drop-shadow (for hover/selected glow) -->
            <DropShadowEffect x:Key="AccentGlowEffect"
                              Color="{StaticResource BrandAccentStart}"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.55" />

            <DropShadowEffect x:Key="AccentGlowSoftEffect"
                              Color="{StaticResource BrandAccentStart}"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.35" />

            <DropShadowEffect x:Key="CyanGlowEffect"
                              Color="{StaticResource BrandCyan}"
                              BlurRadius="14"
                              ShadowDepth="0"
                              Opacity="0.45" />

            <DropShadowEffect x:Key="CardElevation"
                              Color="#000000"
                              BlurRadius="24"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.18" />

            <DropShadowEffect x:Key="CardElevationSoft"
                              Color="#000000"
                              BlurRadius="12"
                              ShadowDepth="1"
                              Direction="270"
                              Opacity="0.10" />

            <!-- Existing converters -->
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <conv:BoolToOnOffConverter x:Key="BoolToOnOffConverter" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
            <conv:AuditSeverityToBrushConverter x:Key="AuditSeverityToBrushConverter" />
            <conv:AuditSeverityToGlyphConverter x:Key="AuditSeverityToGlyphConverter" />
            <conv:UtilizationToBrushConverter x:Key="UtilizationToBrushConverter" />
            <conv:InitialsConverter x:Key="InitialsConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <conv:StringEqualsConverter x:Key="StringEqualsConverter" />

            <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Semantic colors (work in both light & dark themes) -->
            <Color x:Key="SemanticErrorColor">#F87171</Color>
            <Color x:Key="SemanticWarnColor">#FBBF24</Color>
            <Color x:Key="SemanticInfoColor">#60A5FA</Color>
            <Color x:Key="SemanticOkColor">#34D399</Color>
            <Color x:Key="SemanticNeutralColor">#9CA3AF</Color>
            <Color x:Key="SemanticDebugColor">#A78BFA</Color>

            <Color x:Key="SemanticErrorSoftColor">#55F87171</Color>
            <Color x:Key="SemanticWarnSoftColor">#55FBBF24</Color>
            <Color x:Key="SemanticInfoSoftColor">#5560A5FA</Color>
            <Color x:Key="SemanticOkSoftColor">#5534D399</Color>

            <SolidColorBrush x:Key="BrushSemanticError" Color="{StaticResource SemanticErrorColor}" />
            <SolidColorBrush x:Key="BrushSemanticWarn" Color="{StaticResource SemanticWarnColor}" />
            <SolidColorBrush x:Key="BrushSemanticInfo" Color="{StaticResource SemanticInfoColor}" />
            <SolidColorBrush x:Key="BrushSemanticOk" Color="{StaticResource SemanticOkColor}" />
            <SolidColorBrush x:Key="BrushSemanticNeutral" Color="{StaticResource SemanticNeutralColor}" />
            <SolidColorBrush x:Key="BrushSemanticDebug" Color="{StaticResource SemanticDebugColor}" />

            <SolidColorBrush x:Key="BrushSemanticErrorSoft" Color="{StaticResource SemanticErrorSoftColor}" />
            <SolidColorBrush x:Key="BrushSemanticWarnSoft" Color="{StaticResource SemanticWarnSoftColor}" />
            <SolidColorBrush x:Key="BrushSemanticInfoSoft" Color="{StaticResource SemanticInfoSoftColor}" />
            <SolidColorBrush x:Key="BrushSemanticOkSoft" Color="{StaticResource SemanticOkSoftColor}" />

            <!-- App-wide accent definitions (light + dark agnostic).
                 wpf-ui ThemeDictionary swaps surface colors, semantic palette stays
                 readable en ambos themes. Para futuro: separate ResourceDictionary
                 por theme con overrides para variantes mate. -->
            <Color x:Key="SurfaceCardBgDarkColor">#1A1F2A</Color>
            <Color x:Key="SurfaceCardBgLightColor">#FFFFFF</Color>
            <Color x:Key="SurfaceDividerColor">#33808080</Color>
            <SolidColorBrush x:Key="BrushSurfaceDivider" Color="{StaticResource SurfaceDividerColor}" />

            <!-- Typography -->
            <Style x:Key="PageTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="PageSubtitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="FieldLabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.85" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.6" />
            </Style>

            <Style x:Key="MetricValueText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="MonoText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Text Styles for DataGrid/GridView cells. WPF DataGridTextColumn + GridViewColumn DisplayMemberBinding
                 generate TextBlock with Foreground hardcoded to SystemColors.WindowTextBrush (legacy).
                 wpf-ui ThemesDictionary doesn't override SystemColors → text invisible in dark theme.
                 Apply via DataGridTextColumn.ElementStyle and GridViewColumn.CellTemplate. -->
            <Style x:Key="DataCellText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="DataMonoCellText" TargetType="TextBlock" BasedOn="{StaticResource DataCellText}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Cards — flat by default, restraint. Hover changes border only. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="CardHover" TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- HeroCard: alias plano de Card. Solo Dashboard lo usa puntualmente. -->
            <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}" />

            <!-- SettingsCard (PowerToys-style: icon + title/desc + control row) -->
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- SettingsGroup (container for grouped SettingsCards) -->
            <Style x:Key="SettingsGroup" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="SettingsGroupHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Margin" Value="2,16,0,8" />
            </Style>

            <!-- SettingsCardIcon glyph -->
            <Style x:Key="SettingsCardIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Width" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SettingsCardDescription" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Page root -->
            <Style x:Key="PageRoot" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="22,18,22,14" />
            </Style>

            <!-- Eyebrow / page title pattern (estilo Linear/Raycast):
                 Eyebrow uppercase letter-spacing + Title weight Light grande + subtitle. -->
            <Style x:Key="EyebrowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <Style x:Key="PageHeroTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!-- Status pill (Ellipse) -->
            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Nav item: gradient rail + glow + slide on hover/selected -->
            <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="6,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid RenderTransformOrigin="0,0.5">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="NavSlide" X="0" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Rail"
                                        Grid.Column="0"
                                        Width="3"
                                        Margin="0,8"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        Opacity="0" />
                                <Border x:Name="Bd"
                                        Grid.Column="1"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Margin="6,0,0,0"
                                        Padding="12,9">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="2" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    <Setter TargetName="Rail" Property="Background" Value="{StaticResource BrandAccentGradientVertical}" />
                                    <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                    <Setter TargetName="Rail" Property="Effect" Value="{StaticResource AccentGlowSoftEffect}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                    <Setter TargetName="Bd" Property="ToolTip" Value="Requiere conexión (Graph o Exchange Online)" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar logo glow -->
            <Style x:Key="BrandLogoGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="{StaticResource BrandAccentSolid}" />
                <Setter Property="Effect" Value="{StaticResource AccentGlowSoftEffect}" />
            </Style>

            <!-- GX monogram BARE — strokes solid, fondo transparente. Default uso chrome (sidebar). -->
            <Style x:Key="GxLogoMark" TargetType="ContentControl">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Viewbox>
                                <Canvas Width="40" Height="28">
                                    <!-- G: D-shape estirada con stub a 60% altura, asimetría humana -->
                                    <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="3.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 16,3 L 5,3 A 9,11 0 0 0 5,25 L 16,25 A 5,5 0 0 0 21,20 L 21,15 L 13,15" />
                                    <!-- X: dos diagonales con cruce off-center (55% vertical) -->
                                    <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="3.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 26,3 L 38,25 M 38,3 L 26,25" />
                                </Canvas>
                            </Viewbox>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- GX monogram BADGE — pill gradient. Solo para splash/About/marketing surface. -->
            <Style x:Key="GxLogoBadge" TargetType="ContentControl">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border CornerRadius="14"
                                    Background="{StaticResource BrandAccentGradient}">
                                <Viewbox Margin="10">
                                    <Canvas Width="40" Height="28">
                                        <Path Stroke="White" StrokeThickness="3.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 16,3 L 5,3 A 9,11 0 0 0 5,25 L 16,25 A 5,5 0 0 0 21,20 L 21,15 L 13,15" />
                                        <Path Stroke="White" StrokeThickness="3.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 26,3 L 38,25 M 38,3 L 26,25" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global DataGrid theme-aware (legacy WPF default Foreground = black hardcoded; wpf-ui doesn't restyle DataGrid) -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeight" Value="32" />
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <!-- Global ListView (GridView) theme-aware -->
            <Style TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <!-- Global ProgressBar — flat brand accent, sin glow ni gradient -->
            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="4" />
                <Setter Property="Foreground" Value="{StaticResource BrandAccentSolid}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border CornerRadius="2"
                                    Background="{TemplateBinding Background}">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            CornerRadius="2"
                                            Background="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global ListBox theme-aware (used in Users/Groups searches) -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Native TextBox focus accent (wpf-ui ui:TextBox uses its own template;
                 this catches plain TextBox in dialogs/legacy spots). -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource BrandAccentSolid}" />
                <Setter Property="SelectionBrush" Value="{StaticResource BrandAccentSolid}" />
                <Setter Property="SelectionOpacity" Value="0.35" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrandAccentSolid}" />
                        <Setter Property="Effect" Value="{StaticResource AccentGlowSoftEffect}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- PasswordBox parity with TextBox -->
            <Style TargetType="PasswordBox">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource BrandAccentSolid}" />
                <Setter Property="SelectionBrush" Value="{StaticResource BrandAccentSolid}" />
                <Setter Property="SelectionOpacity" Value="0.35" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrandAccentSolid}" />
                        <Setter Property="Effect" Value="{StaticResource AccentGlowSoftEffect}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- CheckBox accent (override stock blue) -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- RadioButton accent -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Sidebar glass surface — neutral, sin overlay coloreado (evita tint verde sobre Mica) -->
            <Style x:Key="SidebarBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>

            <!-- Status bar bottom — glass + thin top gradient line -->
            <Style x:Key="StatusBarSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHighlight}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <!-- Pill (severity / status badge) — uniform shape, glow on hover -->
            <Style x:Key="SeverityPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Futurista PrimaryButton override (ui:Button Appearance=Primary) -->
            <Style x:Key="PrimaryActionButton" TargetType="Control">
                <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHighlight}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Effect" Value="{StaticResource AccentGlowSoftEffect}" />
            </Style>

            <!-- DataTemplates -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <v:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
                <v:ConnectView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
                <v:GroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SharedMailboxViewModel}">
                <v:SharedMailboxView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditViewModel}">
                <v:AuditView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TenantHealthViewModel}">
                <v:TenantHealthView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <v:UsersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OffboardingViewModel}">
                <v:OffboardingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
                <v:OnboardingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MailboxRulesViewModel}">
                <v:MailboxRulesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MailFlowRulesViewModel}">
                <v:MailFlowRulesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
                <v:AuditLogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CertWizardViewModel}">
                <v:CertWizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DomainCheckViewModel}">
                <v:DomainCheckView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PsConsoleViewModel}">
                <v:PsConsoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UserDetailsViewModel}">
                <v:UserDetailsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
