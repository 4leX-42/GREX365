<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Grex365.Core\Grex365.Core.csproj" />
    <ProjectReference Include="..\Grex365.PowerShell\Grex365.PowerShell.csproj" />
  </ItemGroup>

  <!-- UseWindowsForms enables WinForms types (NotifyIcon for tray) but the
       implicit `using System.Windows.Forms` collides with WPF `UserControl`.
       Remove the implicit import; TrayIconService uses fully qualified names. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>


  <ItemGroup>
    <!-- Splash nativo: se muestra antes de cargar el CLR — tapa el arranque JIT (5-15s en frío). -->
    <SplashScreen Include="Assets\Splash.png" />
    <Resource Include="Assets\Grex365.ico" />
  </ItemGroup>

  <!-- PowerShell SDK: en publish con RID los módulos built-in quedan en
       runtimes\win\lib\netX\Modules, pero el motor embebido solo los busca en $PSHOME\Modules
       (la raíz de la app). Sin esta copia, la app PUBLICADA falla con "Cannot find the built-in
       module 'Microsoft.PowerShell.Utility' compatible with the 'Core' edition" en el primer
       Sort-Object/Get-Module. El build normal (bin\) no lo sufre: ahí el probing de runtimes sí
       funciona. Detectado en el smoke E2E de Velopack (2026-06-05). -->
  <Target Name="CopyPwshBuiltinModulesToPublishRoot" AfterTargets="Publish">
    <ItemGroup>
      <!-- Ruta literal (net10.0): un comodín net* desplaza el RecursiveDir y anida mal la copia.
           Actualizar al subir de TFM. -->
      <_PwshBuiltinModules Include="$(PublishDir)runtimes\win\lib\net10.0\Modules\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PwshBuiltinModules)"
          DestinationFiles="@(_PwshBuiltinModules->'$(PublishDir)Modules\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="PowerShell built-in modules copiados a $(PublishDir)Modules (@(_PwshBuiltinModules->Count()) ficheros)" />
  </Target>

  <!-- Estas dos dlls se ofuscan post-publish (Build-Velopack.ps1). R2R las haría mixed-mode
       y Obfuscar/Cecil no puede reescribirlas ("Writing mixed-mode assemblies is not
       supported") — quedan IL-only (JIT; coste de arranque marginal, el splash lo tapa). -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Grex365.Core.dll" />
    <PublishReadyToRunExclude Include="Grex365.PowerShell.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Grex365.App</RootNamespace>
    <AssemblyName>Grex365</AssemblyName>
    <!-- Velopack necesita correr antes que WPF (hooks de install/update) — Main propio en Program.cs. -->
    <StartupObject>Grex365.App.Program</StartupObject>
    <!-- Icono del exe (taskbar/alt-tab). Regenerar con packaging/assets/New-BrandAssets.ps1. -->
    <ApplicationIcon>Assets\Grex365.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is set via app.manifest (true/PM) — canonical for WPF.
         WFO0003 is a WinForms-only check that asks to use ApplicationHighDpiMode,
         but WPF reads the manifest first. Suppress to keep manifest as source of truth. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
