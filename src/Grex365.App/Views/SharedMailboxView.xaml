<UserControl x:Class="Grex365.App.Views.SharedMailboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:v="clr-namespace:Grex365.App.Views"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{l:L10n Key=SharedMailbox.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=SharedMailbox.Title}" Style="{StaticResource PageHeroTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:L10n Key=SharedMailbox.Subtitle}"
                       Style="{StaticResource PageSubtitleText}" />

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=SharedMailbox.TargetMailbox}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:UserPickerBox Grid.Column="0"
                                         Text="{Binding MailboxIdentity, Mode=TwoWay}"
                                         Placeholder="{l:L10n Key=SharedMailbox.Identity.Placeholder}" />
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=SharedMailbox.Button.Lookup}"
                                   Margin="8,0,0,0"
                                   Command="{Binding LookupCommand}" />
                        <ui:Button Grid.Column="2"
                                   Content="{l:L10n Key=SharedMailbox.Button.ConvertRegular}"
                                   Appearance="Primary"
                                   Margin="8,0,0,0"
                                   Command="{Binding ConvertToRegularCommand}"
                                   Visibility="{Binding MailboxInfo, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,8,0,0"
                            Margin="0,4,0,0"
                            Visibility="{Binding MailboxInfo, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:L10n Key=SharedMailbox.Field.Identity}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MailboxInfo.Identity}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:L10n Key=SharedMailbox.Field.DisplayName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MailboxInfo.DisplayName}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:L10n Key=SharedMailbox.Field.PrimarySmtp}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MailboxInfo.PrimarySmtpAddress}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:L10n Key=SharedMailbox.Field.Type}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding MailboxInfo.RecipientTypeDetails}"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" Opacity="0.85" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding CurrentPermissions.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=SharedMailbox.CurrentPermissions}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding CurrentPermissions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MailboxPermissionEntry}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Permission}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Principal}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=SharedMailbox.ApplyPermissions}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding MailboxInfo, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:UserPickerBox Grid.Column="0"
                                         Text="{Binding PermPrincipal, Mode=TwoWay}"
                                         Placeholder="{l:L10n Key=SharedMailbox.Permission.Principal.Placeholder}" />
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding PermAction}"
                                  SelectedValuePath="Tag"
                                  Width="100"
                                  Margin="8,0,0,0">
                            <ComboBoxItem Content="add" Tag="add" />
                            <ComboBoxItem Content="remove" Tag="remove" />
                        </ComboBox>
                        <ComboBox Grid.Column="2"
                                  SelectedValue="{Binding PermPermission}"
                                  SelectedValuePath="Tag"
                                  Width="150"
                                  Margin="8,0,0,0">
                            <ComboBoxItem Content="FullAccess" Tag="FullAccess" />
                            <ComboBoxItem Content="SendAs" Tag="SendAs" />
                            <ComboBoxItem Content="SendOnBehalf" Tag="SendOnBehalf" />
                        </ComboBox>
                        <ui:Button Grid.Column="3"
                                   Content="{l:L10n Key=SharedMailbox.Button.Apply}"
                                   Appearance="Primary"
                                   Margin="8,0,0,0"
                                   Command="{Binding ApplyPermissionCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="{l:L10n Key=SharedMailbox.Button.ImportCsv}"
                                   Margin="0,0,8,0"
                                   Command="{Binding ImportPermissionsCsvCommand}" />
                        <ui:Button Content="{l:L10n Key=SharedMailbox.Button.ExportResults}"
                                   Command="{Binding ExportPermissionResultsCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding PermissionResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MailboxPermissionResult}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Action}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Permission}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Mailbox}" Opacity="0.85" />
                                    <TextBlock Grid.Column="3" Text="{Binding Principal}" Opacity="0.85" />
                                    <TextBlock Grid.Column="4" Text="{Binding Status}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
