<UserControl x:Class="Grex365.App.Views.TenantHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="{l:L10n Key=TenantHealth.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=TenantHealth.Title}"
                       FontSize="28"
                       FontWeight="Light"
                       VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitleText}"
                   Text="{l:L10n Key=TenantHealth.Subtitle}" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Appearance="Primary"
                           Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:L10n Key=TenantHealth.Refresh}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="{l:L10n Key=TenantHealth.Cancel}" />
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="8,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" Opacity="0.85" />
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,16"
                     Visibility="{Binding Health, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=TenantHealth.Card.Organization}" Opacity="0.75" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding Health.DisplayName, FallbackValue=—}"
                               FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Health.VerifiedDomain, FallbackValue=—}"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=TenantHealth.Card.Users}" Opacity="0.75" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MetricValueText}"
                               Text="{Binding Health.TotalUsers, FallbackValue=0}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{l:L10n Key=TenantHealth.Card.Users.Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=TenantHealth.Card.Groups}" Opacity="0.75" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MetricValueText}"
                               Text="{Binding Health.TotalGroups, FallbackValue=0}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{l:L10n Key=TenantHealth.Card.Groups.Caption}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l:L10n Key=TenantHealth.Licenses.Title}"
                               Style="{StaticResource SectionTitleText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Search lupa: filtra por FriendlyName/SkuPartNumber/CategoryLabel -->
                    <Border Grid.Column="1"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="10,7"
                            MinHeight="38"
                            MaxWidth="380"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding LicenseFilter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     FontSize="14"
                                     ToolTip="{l:L10n Key=TenantHealth.Filter.Tooltip}"
                                     Padding="0" />
                            <Button Grid.Column="2"
                                    Content="×"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,0"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Command="{Binding ClearFilterCommand}"
                                    Visibility="{Binding LicenseFilter, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"
                                    ToolTip="{l:L10n Key=TenantHealth.Filter.Clear.Tooltip}" />
                        </Grid>
                    </Border>

                    <ui:Button Grid.Column="2"
                               Margin="12,0,8,0"
                               Command="{Binding GoToUsersCommand}"
                               ToolTip="{l:L10n Key=TenantHealth.Manage.Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="13"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{l:L10n Key=TenantHealth.Manage}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding Health, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{l:L10n Key=TenantHealth.Total.Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock>
                            <Run Text="{Binding TotalConsumed, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalEnabled, Mode=OneWay}" />
                            <Run Text="  · " Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding OverallPercent, StringFormat={}{0:F1}%}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,16,12">
                    <ItemsControl ItemsSource="{Binding LicensesView}"
                                  Background="Transparent"
                                  xmlns:vm="clr-namespace:Grex365.App.ViewModels">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6"
                                                Padding="12,6"
                                                Margin="0,16,0,8">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Opacity="0.85" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LicenseCard}">
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="6"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding UtilizationLevel, Converter={StaticResource UtilizationToBrushConverter}}">
                                            <TextBlock Text=""
                                                       FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="14"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FriendlyName}" Style="{StaticResource SettingsCardTitle}" />
                                            <TextBlock Text="{Binding SkuPartNumber}" Style="{StaticResource SettingsCardDescription}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <ProgressBar Minimum="0"
                                                         Maximum="{Binding Enabled}"
                                                         Value="{Binding Consumed, Mode=OneWay}"
                                                         Height="4"
                                                         Foreground="{Binding UtilizationLevel, Converter={StaticResource UtilizationToBrushConverter}}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0">
                                                <Run Text="{Binding Consumed, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding Enabled, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Run Text="{Binding Available, Mode=OneWay}" />
                                                <Run Text="{l:L10n Key=TenantHealth.License.FreeSuffix}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PercentUsed, StringFormat={}{0:F0}%}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{Binding UtilizationLevel, Converter={StaticResource UtilizationToBrushConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
