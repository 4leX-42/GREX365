<UserControl x:Class="Grex365.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{l:L10n Key=Dashboard.Eyebrow}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:L10n Key=Dashboard.Title}"
                           Style="{StaticResource PageHeroTitle}" />
                <TextBlock Text="{l:L10n Key=Dashboard.Subtitle}"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Dashboard.QuickActions}" Style="{StaticResource SectionTitleText}" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,8"
                                   Appearance="Primary"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.Connection">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Dashboard.Action.Connect}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.Licenses">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Dashboard.Action.Licenses}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.Users">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Dashboard.Action.SearchUser}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.Audit">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Dashboard.Action.Audit}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.Offboarding">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Dashboard.Action.Offboarding}" />
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:L10n Key=Dashboard.Section.Status}" Style="{StaticResource SectionTitleText}" />

            <UniformGrid Columns="2" Rows="2">
                <Border Style="{StaticResource MetricCard}" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{l:L10n Key=Dashboard.Graph}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MetricValueText}"
                                   Text="{Binding GraphConnected, Converter={StaticResource BoolToOnOffConverter}}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{l:L10n Key=Dashboard.Graph.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{l:L10n Key=Dashboard.Exchange}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MetricValueText}"
                                   Text="{Binding ExchangeConnected, Converter={StaticResource BoolToOnOffConverter}}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{l:L10n Key=Dashboard.Exchange.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <TextBlock Text="{l:L10n Key=Dashboard.Tenant}" FontWeight="SemiBold" FontSize="13" Opacity="0.85" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding TenantDomain, FallbackValue=—, TargetNullValue=—}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MonoText}"
                                   Text="{Binding TenantId, FallbackValue=—, TargetNullValue=—}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:L10n Key=Dashboard.Account}" FontWeight="SemiBold" FontSize="13" Opacity="0.85" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding Account, FallbackValue=—, TargetNullValue=—}"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="{l:L10n Key=Dashboard.Account.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{l:L10n Key=Dashboard.LastAudit}"
                       Style="{StaticResource SectionTitleText}"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasLastAudit, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border Style="{StaticResource Card}"
                    Padding="20"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasLastAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LastAuditName, FallbackValue=—}"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       Text="{Binding LastAuditAt, StringFormat={l:L10n Key=Dashboard.LastAudit.RunAt}}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=Dashboard.LastAudit.Open}"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.Audit"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{DynamicResource BrushSemanticErrorSoft}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BrushSemanticError}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:L10n Key=Dashboard.LastAudit.Pill.Error}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticError}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastAuditErrors, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSemanticWarnSoft}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BrushSemanticWarn}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:L10n Key=Dashboard.LastAudit.Pill.Warn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticWarn}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastAuditWarnings, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSemanticInfoSoft}" CornerRadius="14" Padding="12,6"
                                BorderBrush="{DynamicResource BrushSemanticInfo}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:L10n Key=Dashboard.LastAudit.Pill.Info}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticInfo}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastAuditInfo, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:L10n Key=Dashboard.Activity.Title}"
                       Style="{StaticResource SectionTitleText}"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Border Style="{StaticResource Card}"
                    Padding="20"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding TodayOpsCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{l:L10n Key=Dashboard.Activity.TodayOps}" />
                            <Run Text=" · " />
                            <Run Text="{Binding TodayErrorCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{l:L10n Key=Dashboard.Activity.TodayErrors}" />
                        </TextBlock>
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=Dashboard.Activity.Open}"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Nav.AuditLog"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentOps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource BrushSemanticOk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="ERROR">
                                                        <Setter Property="Fill" Value="{DynamicResource BrushSemanticError}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="WARN">
                                                        <Setter Property="Fill" Value="{DynamicResource BrushSemanticWarn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Timestamp, StringFormat=HH:mm}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source}" FontSize="11" />
                                    </Border>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
