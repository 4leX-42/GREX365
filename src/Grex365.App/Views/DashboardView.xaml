<UserControl x:Class="Grex365.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="DASHBOARD" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Estado de la conexión"
                           Style="{StaticResource PageHeroTitle}" />
                <TextBlock Text="Resumen del tenant y enlaces rápidos"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Acciones rápidas" Style="{StaticResource SectionTitleText}" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,8"
                                   Appearance="Primary"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Conexión">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Conectar" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Salud tenant">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Salud tenant" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Usuarios">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Buscar usuario" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Auditoría">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Auditoría" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,8"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Offboarding">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Offboarding" />
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Estado" Style="{StaticResource SectionTitleText}" />

            <UniformGrid Columns="2" Rows="2">
                <Border Style="{StaticResource MetricCard}" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Microsoft Graph"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MetricValueText}"
                                   Text="{Binding GraphConnected, Converter={StaticResource BoolToOnOffConverter}}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Conexión SDK + REST" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Exchange Online"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MetricValueText}"
                                   Text="{Binding ExchangeConnected, Converter={StaticResource BoolToOnOffConverter}}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Cmdlets PowerShell remoto" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <TextBlock Text="Tenant" FontWeight="SemiBold" FontSize="13" Opacity="0.85" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding TenantDomain, FallbackValue=Sin conexión}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MonoText}"
                                   Text="{Binding TenantId, FallbackValue=—}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cuenta" FontWeight="SemiBold" FontSize="13" Opacity="0.85" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding Account, FallbackValue=Sin conexión}"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="App principal autenticada"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Última auditoría"
                       Style="{StaticResource SectionTitleText}"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasLastAudit, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border Style="{StaticResource Card}"
                    Padding="20"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasLastAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LastAuditName, FallbackValue=—}"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       Text="{Binding LastAuditAt, StringFormat='Ejecutada {0:dd/MM/yyyy HH:mm} UTC'}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Content="Abrir Auditoría"
                                   Command="{Binding GoToCommand}"
                                   CommandParameter="Auditoría"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{DynamicResource BrushSemanticErrorSoft}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BrushSemanticError}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ERROR" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticError}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastAuditErrors, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSemanticWarnSoft}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BrushSemanticWarn}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="WARN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticWarn}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastAuditWarnings, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSemanticInfoSoft}" CornerRadius="14" Padding="12,6"
                                BorderBrush="{DynamicResource BrushSemanticInfo}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="INFO" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticInfo}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastAuditInfo, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
