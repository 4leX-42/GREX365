<UserControl x:Class="Grex365.App.Views.MailFlowRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             mc:Ignorable="d">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{l:L10n Key=MailFlow.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=MailFlow.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="{l:L10n Key=MailFlow.Subtitle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

        <Border Grid.Row="2" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Content="{l:L10n Key=MailFlow.Load}"
                           Appearance="Primary"
                           Command="{Binding LoadCommand}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:L10n Key=MailFlow.Filter.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <ui:TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                Width="240"
                                PlaceholderText="{l:L10n Key=MailFlow.Filter.Placeholder}" />
                </StackPanel>
                <ui:ProgressRing Grid.Column="2"
                                 IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" CornerRadius="8" Padding="0"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="12,8" Opacity="0.8" Text="{Binding StatusMessage}" />
                <DataGrid ItemsSource="{Binding Filtered}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:L10n Key=MailFlow.Column.Priority}"    Binding="{Binding Priority}"     Width="60"  ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=MailFlow.Column.State}"       Binding="{Binding State}"        Width="80"  ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=MailFlow.Column.Mode}"        Binding="{Binding Mode}"         Width="90"  ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=MailFlow.Column.Name}"        Binding="{Binding Name}"         Width="260" ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=MailFlow.Column.Description}" Binding="{Binding Description}"  Width="*"   ElementStyle="{StaticResource DataCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
