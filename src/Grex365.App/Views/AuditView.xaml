<UserControl x:Class="Grex365.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RunCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportFindingsCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="{l:L10n Key=Audit.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=Audit.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="{l:L10n Key=Audit.Subtitle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Section.Scenarios}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{l:L10n Key=Audit.Scenario.RiskyAccounts}"
                                   Appearance="Primary"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunScenarioRiskyAccountsCommand}"
                                   ToolTip="{l:L10n Key=Audit.Scenario.RiskyAccounts.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Scenario.Privileged}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunScenarioPrivilegedCommand}"
                                   ToolTip="{l:L10n Key=Audit.Scenario.Privileged.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Scenario.MailHygiene}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunScenarioMailHygieneCommand}"
                                   ToolTip="{l:L10n Key=Audit.Scenario.MailHygiene.Tooltip}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Section.Identity}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{l:L10n Key=Audit.Run.IdentityGroups}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.IdentityGroups.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.Mfa}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunMfaCoverageAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.Mfa.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.PrivilegedRoles}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunPrivilegedRolesAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.PrivilegedRoles.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.Activity}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunActivityAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.Activity.Tooltip}" />
                        <TextBlock VerticalAlignment="Center" Text="&gt;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,4" />
                        <ui:NumberBox Width="60" Margin="0,0,2,4"
                                      Value="{Binding InactivityDays}" Minimum="1" Maximum="180"
                                      ToolTip="{l:L10n Key=Audit.Inactivity.Tooltip}" />
                        <TextBlock VerticalAlignment="Center" Text="d" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Section.Security}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{l:L10n Key=Audit.Run.CaPolicies}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunCaPoliciesAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.CaPolicies.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.TenantDefaults}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunTenantDefaultsAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.TenantDefaults.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.OAuth}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunOAuthGrantsAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.OAuth.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.AppCredentials}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunAppCredentialsAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.AppCredentials.Tooltip}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Section.Mail}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{l:L10n Key=Audit.Run.ExternalForwarding}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunExternalForwardingAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.ExternalForwarding.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.InboxRules}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunInboxRulesAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.InboxRules.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.TransportRules}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunTransportRulesAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.TransportRules.Tooltip}" />
                        <ui:Button Content="{l:L10n Key=Audit.Run.SharedMailboxSignIn}"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunSharedMailboxSignInAuditCommand}"
                                   ToolTip="{l:L10n Key=Audit.Run.SharedMailboxSignIn.Tooltip}" />
                        <TextBlock VerticalAlignment="Center" Text="{l:L10n Key=Audit.MailboxScanCap.Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,4,4" />
                        <ui:NumberBox Width="60" Margin="0,0,0,4"
                                      Value="{Binding InboxRuleScanCap}" Minimum="1" Maximum="5000"
                                      ToolTip="{l:L10n Key=Audit.MailboxScanCap.Tooltip}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <WrapPanel Orientation="Horizontal">
                <ui:Button Content="{l:L10n Key=Audit.Cancel}"
                           Margin="0,0,8,0"
                           Command="{Binding CancelCommand}"
                           ToolTip="{l:L10n Key=Audit.Cancel.Tooltip}" />
                <ui:Button Content="{l:L10n Key=Audit.Export.Csv}"
                           Margin="0,0,8,0"
                           Command="{Binding ExportFindingsCommand}"
                           ToolTip="{l:L10n Key=Audit.Export.Csv.Tooltip}" />
                <ui:Button Content="{l:L10n Key=Audit.Export.Html}"
                           Margin="0,0,8,0"
                           Command="{Binding ExportFindingsHtmlCommand}"
                           ToolTip="{l:L10n Key=Audit.Export.Html.Tooltip}" />
                <ui:Button Content="{l:L10n Key=Audit.Export.Json}"
                           Margin="0,0,8,0"
                           Command="{Binding ExportFindingsJsonCommand}"
                           ToolTip="{l:L10n Key=Audit.Export.Json.Tooltip}" />
                <ui:Button Content="{l:L10n Key=Audit.Baseline.Load}"
                           Margin="0,0,8,0"
                           Command="{Binding LoadBaselineCommand}"
                           ToolTip="{l:L10n Key=Audit.Baseline.Load.Tooltip}" />
                <ui:Button Content="{l:L10n Key=Audit.Baseline.Clear}"
                           Margin="0,0,8,0"
                           Visibility="{Binding HasBaseline, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                           Command="{Binding ClearBaselineCommand}" />
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="8,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           Opacity="0.8" />
            </WrapPanel>
        </StackPanel>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,12"
                     Visibility="{Binding Summary, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
            <Border CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Summary.Users}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Summary.UsersTotal, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock>
                        <Run Text="{l:L10n Key=Audit.Summary.Enabled}" />
                        <Run Text="{Binding Summary.UsersEnabled, FallbackValue=0}" />
                        <Run Text="{l:L10n Key=Audit.Summary.Disabled}" />
                        <Run Text="{Binding Summary.UsersDisabled, FallbackValue=0}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Summary.StaleMembers}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Summary.StaleMembers, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{l:L10n Key=Audit.Summary.StaleMembers.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Summary.StaleGuests}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Summary.StaleGuests, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{l:L10n Key=Audit.Summary.StaleGuests.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Audit.Summary.DisabledLicensed}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Summary.DisabledWithLicense, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{l:L10n Key=Audit.Summary.DisabledLicensed.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{l:L10n Key=Audit.Findings.Title}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushSemanticErrorSoft}" CornerRadius="14" Padding="10,4" Margin="4,0" BorderBrush="{DynamicResource BrushSemanticError}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:L10n Key=Audit.Findings.Pill.Error}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticError}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSemanticWarnSoft}" CornerRadius="14" Padding="10,4" Margin="4,0" BorderBrush="{DynamicResource BrushSemanticWarn}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:L10n Key=Audit.Findings.Pill.Warn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticWarn}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WarningCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSemanticInfoSoft}" CornerRadius="14" Padding="10,4" Margin="4,0" BorderBrush="{DynamicResource BrushSemanticInfo}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:L10n Key=Audit.Findings.Pill.Info}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushSemanticInfo}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InfoCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{l:L10n Key=Audit.Findings.Pill.Error}" IsChecked="{Binding ShowErrors}" Margin="4,0" Foreground="{DynamicResource BrushSemanticError}" FontWeight="SemiBold" />
                        <CheckBox Content="{l:L10n Key=Audit.Findings.Pill.Warn}" IsChecked="{Binding ShowWarnings}" Margin="4,0" Foreground="{DynamicResource BrushSemanticWarn}" FontWeight="SemiBold" />
                        <CheckBox Content="{l:L10n Key=Audit.Findings.Pill.Info}" IsChecked="{Binding ShowInfo}" Margin="4,0" Foreground="{DynamicResource BrushSemanticInfo}" FontWeight="SemiBold" />
                        <ui:TextBox Width="200"
                                    Margin="12,0,0,0"
                                    PlaceholderText="{l:L10n Key=Audit.Findings.Filter.Placeholder}"
                                    Text="{Binding FindingsFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,40"
                                Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                        <TextBlock Text=""
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{l:L10n Key=Audit.Findings.Empty.Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{l:L10n Key=Audit.Findings.Empty.Hint}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                <ListView ItemsSource="{Binding FindingsView}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <!-- Clean rows: padded, rounded, subtle hover/selected. Replaces the
                             default thin GridView row + harsh gray hover bar. -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,9" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <GridViewRowPresenter VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{l:L10n Key=Audit.Column.Category}" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource DataCellText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:L10n Key=Audit.Column.Identity}" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Identity}" Style="{StaticResource DataCellText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:L10n Key=Audit.Column.Detail}" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DataCellText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:L10n Key=Audit.Column.Severity}" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource AuditSeverityToGlyphConverter}}"
                                                       FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Severity, Converter={StaticResource AuditSeverityToBrushConverter}}" />
                                            <TextBlock Text="{Binding Severity}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Severity, Converter={StaticResource AuditSeverityToBrushConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:L10n Key=Audit.Column.Actions}" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Only 'Disabled+License' findings are auto-fixable (guided offboarding). -->
                                        <ui:Button Content="{l:L10n Key=Audit.Action.Fix}"
                                                   Appearance="Primary"
                                                   FontSize="11"
                                                   Padding="10,2"
                                                   ToolTip="{l:L10n Key=Audit.Action.Fix.Tooltip}"
                                                   Visibility="{Binding IsAutoFixable, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                                                   Command="{Binding DataContext.FixDisabledWithLicenseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Independent live corrective-action panel (slides over the right side). -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Width="440"
                HorizontalAlignment="Right"
                Panel.ZIndex="60"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding CorrectivePanelVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <DockPanel Margin="18,16,16,16">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{l:L10n Key=Audit.Fix.PanelTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CorrectiveUser}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0"
                                         Visibility="{Binding CorrectiveRunning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <ui:Button Content="{l:L10n Key=Audit.Fix.Close}"
                                   Command="{Binding CloseCorrectivePanelCommand}" />
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" CornerRadius="6" Padding="10,8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding CorrectiveSummary, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding CorrectiveSummary}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CorrectiveSteps}"
                                  xmlns:m="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:OffboardingStep}">
                                <Border CornerRadius="6" Padding="10,8" Margin="0,3"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Status badge -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                                VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#553B82F6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Background" Value="#5522C55E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ERROR">
                                                            <Setter Property="Background" Value="#55EF4444" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OMITIDO">
                                                            <Setter Property="Background" Value="#55F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
