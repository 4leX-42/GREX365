<UserControl x:Class="Grex365.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RunCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportFindingsCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.85" />
            <TextBlock Text="Auditoría de identidades" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="Detecta usuarios obsoletos, deshabilitados con licencia y otros hallazgos"
                   Opacity="0.7"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <!-- Pre-canned scenarios (combos comunes) -->
            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                    <TextBlock Text="ESCENARIOS RÁPIDOS" FontSize="10" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="Cuentas en riesgo (deshab + licencia)"
                                   Appearance="Primary"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunScenarioRiskyAccountsCommand}"
                                   ToolTip="Identidad + grupos + filtra automáticamente disabled-con-licencia (coste evitable + riesgo perdida info)." />
                        <ui:Button Content="Acceso privilegiado"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunScenarioPrivilegedCommand}"
                                   ToolTip="Privileged roles + MFA + CA policies — verifica posture admin." />
                        <ui:Button Content="Higiene mail (BEC)"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunScenarioMailHygieneCommand}"
                                   ToolTip="Forwarding externo + Inbox rules + Transport rules + Shared mailbox sign-in (vectores BEC clásicos)." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Identidad -->
            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="IDENTIDAD" FontSize="10" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="Identidad + grupos"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunCommand}"
                                   ToolTip="Identity audit (stale members + disabled+licensed) + Groups audit (sin owner / vacíos / guests en privados). Atajo: Ctrl+R" />
                        <ui:Button Content="MFA coverage"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunMfaCoverageAuditCommand}"
                                   ToolTip="/reports/authenticationMethods/userRegistrationDetails: cobertura MFA. Admin sin MFA = ERROR crítico." />
                        <ui:Button Content="Privileged roles"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunPrivilegedRolesAuditCommand}"
                                   ToolTip="/directoryRoles + members: detecta 0/1/&gt;5 Global Admins, guests con role admin, etc." />
                        <ui:Button Content="Actividad grupos"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunActivityAuditCommand}"
                                   ToolTip="Descarga /reports/getOffice365GroupsActivityDetail" />
                        <TextBlock VerticalAlignment="Center" Text="&gt;" Opacity="0.7" Margin="0,0,4,4" />
                        <ui:NumberBox Width="60" Margin="0,0,2,4"
                                      Value="{Binding InactivityDays}" Minimum="1" Maximum="180"
                                      ToolTip="Días sin actividad (1-180)" />
                        <TextBlock VerticalAlignment="Center" Text="d" Opacity="0.7" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Seguridad / Tenant -->
            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="SEGURIDAD / TENANT" FontSize="10" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="CA policies"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunCaPoliciesAuditCommand}"
                                   ToolTip="/identity/conditionalAccess/policies. Requiere Policy.Read.All." />
                        <ui:Button Content="Tenant defaults"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunTenantDefaultsAuditCommand}"
                                   ToolTip="/policies/authorizationPolicy + securityDefaults" />
                        <ui:Button Content="OAuth grants"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunOAuthGrantsAuditCommand}"
                                   ToolTip="/oauth2PermissionGrants — scopes peligrosos" />
                        <ui:Button Content="App credentials"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunAppCredentialsAuditCommand}"
                                   ToolTip="/applications passwordCredentials / keyCredentials expiry" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Mail / EXO -->
            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="MAIL / EXO" FontSize="10" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="Forwarding externo"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunExternalForwardingAuditCommand}"
                                   ToolTip="Get-Mailbox + Get-AcceptedDomain: detecta ForwardingSmtpAddress externos" />
                        <ui:Button Content="Inbox rules"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunInboxRulesAuditCommand}"
                                   ToolTip="Get-InboxRule por buzón — patrón BEC" />
                        <ui:Button Content="Transport rules"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunTransportRulesAuditCommand}"
                                   ToolTip="Get-TransportRule: ForwardTo/BCC/Redirect externos" />
                        <ui:Button Content="Shared mailbox sign-in"
                                   Margin="0,0,8,4"
                                   Command="{Binding RunSharedMailboxSignInAuditCommand}"
                                   ToolTip="Shared boxes con AccountDisabled=false" />
                        <TextBlock VerticalAlignment="Center" Text="Tope:" Opacity="0.7" Margin="8,0,4,4" />
                        <ui:NumberBox Width="60" Margin="0,0,0,4"
                                      Value="{Binding InboxRuleScanCap}" Minimum="1" Maximum="5000"
                                      ToolTip="Cuántos buzones escanear (Get-InboxRule N+1)" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Row 3: Actions + status -->
            <WrapPanel Orientation="Horizontal">
                <ui:Button Content="Cancelar"
                           Margin="0,0,8,0"
                           Command="{Binding CancelCommand}"
                           ToolTip="Cancelar audit en curso. Atajo: Esc" />
                <ui:Button Content="Exportar CSV..."
                           Margin="0,0,8,0"
                           Command="{Binding ExportFindingsCommand}"
                           ToolTip="Exporta findings filtrados (respeta toggles ERROR/WARN/INFO + búsqueda). Atajo: Ctrl+E" />
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="8,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           Opacity="0.8" />
            </WrapPanel>
        </StackPanel>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,12"
                     Visibility="{Binding Summary, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
            <Border CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Usuarios" Opacity="0.7" />
                    <TextBlock Text="{Binding Summary.UsersTotal, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock>
                        <Run Text="Habilitados: " />
                        <Run Text="{Binding Summary.UsersEnabled, FallbackValue=0}" />
                        <Run Text=" · Deshab: " />
                        <Run Text="{Binding Summary.UsersDisabled, FallbackValue=0}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Stale members" Opacity="0.7" />
                    <TextBlock Text="{Binding Summary.StaleMembers, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text=">180 días sin login" Opacity="0.6" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Stale guests" Opacity="0.7" />
                    <TextBlock Text="{Binding Summary.StaleGuests, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text=">90 días sin login" Opacity="0.6" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Deshab + licencia" Opacity="0.7" />
                    <TextBlock Text="{Binding Summary.DisabledWithLicense, FallbackValue=0}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Coste evitable" Opacity="0.6" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Hallazgos"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="#55EF4444" CornerRadius="12" Padding="12,4" Margin="4,0" BorderBrush="#EF4444" BorderThickness="1">
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="ERROR " FontWeight="Bold" Foreground="#FFEAEA" />
                                <Run Text="{Binding ErrorCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" Foreground="#FFFFFF" />
                            </TextBlock>
                        </Border>
                        <Border Background="#55F59E0B" CornerRadius="12" Padding="12,4" Margin="4,0" BorderBrush="#F59E0B" BorderThickness="1">
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="WARN " FontWeight="Bold" Foreground="#FFF8E5" />
                                <Run Text="{Binding WarningCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" Foreground="#FFFFFF" />
                            </TextBlock>
                        </Border>
                        <Border Background="#553B82F6" CornerRadius="12" Padding="12,4" Margin="4,0" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="INFO " FontWeight="Bold" Foreground="#E6F0FF" />
                                <Run Text="{Binding InfoCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" Foreground="#FFFFFF" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="ERROR" IsChecked="{Binding ShowErrors}" Margin="4,0" Foreground="#F87171" FontWeight="SemiBold" />
                        <CheckBox Content="WARN" IsChecked="{Binding ShowWarnings}" Margin="4,0" Foreground="#FBBF24" FontWeight="SemiBold" />
                        <CheckBox Content="INFO" IsChecked="{Binding ShowInfo}" Margin="4,0" Foreground="#60A5FA" FontWeight="SemiBold" />
                        <ui:TextBox Width="200"
                                    Margin="12,0,0,0"
                                    PlaceholderText="Filtrar categoría / identity / detalle..."
                                    Text="{Binding FindingsFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,40"
                                Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                        <TextBlock Text=""
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4" />
                        <TextBlock Text="Sin hallazgos todavía"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Opacity="0.7" />
                        <TextBlock Text="Lanza una auditoría desde la barra superior para empezar."
                                   HorizontalAlignment="Center"
                                   Opacity="0.5" />
                    </StackPanel>
                <ListView ItemsSource="{Binding FindingsView}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Categoría" Width="160" DisplayMemberBinding="{Binding Category}" />
                            <GridViewColumn Header="Identity"  Width="260" DisplayMemberBinding="{Binding Identity}" />
                            <GridViewColumn Header="Detalle"   Width="380" DisplayMemberBinding="{Binding Detail}" />
                            <GridViewColumn Header="Severidad" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource AuditSeverityToGlyphConverter}}"
                                                       FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Severity, Converter={StaticResource AuditSeverityToBrushConverter}}" />
                                            <TextBlock Text="{Binding Severity}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Severity, Converter={StaticResource AuditSeverityToBrushConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
