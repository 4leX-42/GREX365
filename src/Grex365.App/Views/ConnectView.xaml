<UserControl x:Class="Grex365.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{l:L10n Key=Connect.Eyebrow}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:L10n Key=Connect.Title}" Style="{StaticResource PageHeroTitle}" />
                <TextBlock Text="{l:L10n Key=Connect.Subtitle}"
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{l:L10n Key=Connect.MsGraph}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding GraphConnected, Converter={StaticResource BoolToOnOffConverter}}"
                                       VerticalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{l:L10n Key=Connect.ExchangeOnline}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding ExchangeConnected, Converter={StaticResource BoolToOnOffConverter}}"
                                       VerticalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Connect.Section.Actions}" Style="{StaticResource SectionTitleText}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Primary"
                                   Command="{Binding ConnectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Connect.Button.Connect}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Connect.Button.Cancel}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,0" Command="{Binding ConnectDeviceCodeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:L10n Key=Connect.Button.DeviceCode}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,0" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:L10n Key=Connect.Button.Disconnect}" />
                            </StackPanel>
                        </ui:Button>
                        <TextBlock Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.85"
                                   FontSize="13" />
                    </StackPanel>

                    <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Connect.ExoModule.Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{l:L10n Key=Connect.ExoModule.Hint}" Opacity="0.7" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{l:L10n Key=Connect.ExoModule.Probe}" Margin="0,0,8,0" Command="{Binding ProbeExoModuleCommand}" />
                                <ui:Button Content="{l:L10n Key=Connect.ExoModule.Install}" Margin="0,0,8,0" Command="{Binding InstallExoModuleCommand}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding ExoModuleStatus}" Opacity="0.85" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding DeviceCodePromptVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Connect.DeviceCode.Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{l:L10n Key=Connect.DeviceCode.Step1}" Opacity="0.85" />
                            <TextBlock Text="{Binding DeviceCodeVerificationUri}" Style="{StaticResource MonoText}" Margin="0,2,0,8" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{l:L10n Key=Connect.DeviceCode.Step2}" Opacity="0.85" />
                            <TextBlock Text="{Binding DeviceCodeUserCode}" FontSize="22" FontWeight="Bold" Margin="0,2,0,8" Style="{StaticResource MonoText}" />
                            <TextBlock Text="{l:L10n Key=Connect.DeviceCode.Step3}" Opacity="0.85" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Connect.Section.Tenant}" Style="{StaticResource SectionTitleText}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:L10n Key=Connect.Tenant.Id}" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding TenantId, FallbackValue=—}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:L10n Key=Connect.Tenant.Domain}" Opacity="0.7" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantDomain, FallbackValue=—}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:L10n Key=Connect.Tenant.Account}" Opacity="0.7" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Account, FallbackValue=—}" Margin="0,6,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:L10n Key=Connect.Cert.GroupHeader}" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:L10n Key=Connect.Cert.Status}" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="{Binding CertStatusMessage, FallbackValue=—}" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            CornerRadius="10" Padding="10,3"
                            VerticalAlignment="Center"
                            Background="{Binding CertIsValid, Converter={StaticResource BoolToValidityBrushConverter}}"
                            Opacity="0.95">
                        <TextBlock Text="{Binding CertIsValid, Converter={StaticResource BoolToOnOffConverter}, ConverterParameter='Status.Valid/Status.Invalid'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:L10n Key=Connect.Cert.AppId}" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="{l:L10n Key=Connect.Cert.AppId.Hint}" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" VerticalAlignment="Center" Text="{Binding CertAppId, FallbackValue=—}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:L10n Key=Connect.Cert.Thumbprint}" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="{l:L10n Key=Connect.Cert.Thumbprint.Hint}" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"
                               Text="{Binding CertThumbprint, FallbackValue=—}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:L10n Key=Connect.Cert.Expiry}" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="{l:L10n Key=Connect.Cert.Expiry.Hint}" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding CertExpiry, FallbackValue=—}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
