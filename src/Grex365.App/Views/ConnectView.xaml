<UserControl x:Class="Grex365.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONEXIÓN" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="Conexión a Microsoft 365" FontSize="28" FontWeight="Light" />
                    <TextBlock Text="Autenticación por certificado contra Microsoft Graph y Exchange Online"
                               FontSize="12" Opacity="0.6" Margin="0,2,0,16" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Microsoft Graph" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding GraphConnected, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding GraphConnected, Converter={StaticResource BoolToOnOffConverter}}"
                                       VerticalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Exchange Online" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding ExchangeConnected, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding ExchangeConnected, Converter={StaticResource BoolToOnOffConverter}}"
                                       VerticalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Acciones" Style="{StaticResource SectionTitleText}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Primary"
                                   Command="{Binding ConnectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Conectar" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Cancelar" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,0" Command="{Binding ConnectDeviceCodeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Conectar (device code)" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="0,0,8,0" Command="{Binding DisconnectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0" />
                                <TextBlock Text="Desconectar" />
                            </StackPanel>
                        </ui:Button>
                        <TextBlock Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.85"
                                   FontSize="13" />
                    </StackPanel>

                    <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="Exchange Online module" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="ExchangeOnlineManagement (PSGallery) es necesario para conectar EXO. Comprueba + instala desde aqui." Opacity="0.7" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Comprobar" Margin="0,0,8,0" Command="{Binding ProbeExoModuleCommand}" />
                                <ui:Button Content="Instalar EXO module" Margin="0,0,8,0" Command="{Binding InstallExoModuleCommand}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding ExoModuleStatus}" Opacity="0.85" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6" Padding="14" Margin="0,12,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding DeviceCodePromptVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="Device code authentication" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="1) Abre la URL en el navegador" Opacity="0.85" />
                            <TextBlock Text="{Binding DeviceCodeVerificationUri}" Style="{StaticResource MonoText}" Margin="0,2,0,8" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="2) Pega el codigo" Opacity="0.85" />
                            <TextBlock Text="{Binding DeviceCodeUserCode}" FontSize="22" FontWeight="Bold" Margin="0,2,0,8" Style="{StaticResource MonoText}" />
                            <TextBlock Text="3) Inicia sesion con la cuenta admin del tenant" Opacity="0.85" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tenant" Style="{StaticResource SectionTitleText}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tenant ID" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding TenantId, FallbackValue=—}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dominio" Opacity="0.7" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantDomain, FallbackValue=—}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cuenta" Opacity="0.7" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Account, FallbackValue=—}" Margin="0,6,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="CERTIFICADO" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Estado certificado" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="{Binding CertStatusMessage, FallbackValue=—}" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            CornerRadius="10" Padding="10,3"
                            VerticalAlignment="Center"
                            Background="{Binding CertIsValid, Converter={StaticResource BoolToBrushConverter}}"
                            Opacity="0.9">
                        <TextBlock Text="{Binding CertIsValid, Converter={StaticResource BoolToOnOffConverter}, ConverterParameter='válido/inválido'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App ID" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="Application ID en Azure AD" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" VerticalAlignment="Center" Text="{Binding CertAppId, FallbackValue=—}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thumbprint" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="SHA1 del certificado en CurrentUser\My" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"
                               Text="{Binding CertThumbprint, FallbackValue=—}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SettingsCardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Expiración" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock Text="NotAfter del cert" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding CertExpiry, FallbackValue=—}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
