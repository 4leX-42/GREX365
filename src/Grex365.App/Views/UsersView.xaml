<UserControl x:Class="Grex365.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="44" Height="44" CornerRadius="12"
                    Background="{StaticResource BrandAccentGradientSoft}"
                    BorderBrush="{StaticResource GlassBorderHighlight}"
                    BorderThickness="1"
                    Margin="0,0,16,0"
                    Effect="{StaticResource AccentGlowSoftEffect}">
                <TextBlock Text=""
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="22"
                           Foreground="{StaticResource BrandAccentSolid}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Usuarios"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="Buscar, ver y administrar cuentas (habilitar/deshabilitar, quitar licencias)"
                   Opacity="0.7"
                   Margin="0,0,0,16" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Buscar" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Nombre, UPN o email">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Grid.Column="1"
                                   Content="Buscar"
                                   Margin="8,0,0,0"
                                   Command="{Binding SearchCommand}" />
                        <ui:Button Grid.Column="2"
                                   Content="Cancelar"
                                   Margin="8,0,0,0"
                                   Command="{Binding CancelCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,24"
                                    Visibility="{Binding Users.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Opacity="0.4" />
                            <TextBlock Text="Busca un usuario"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Opacity="0.7" />
                            <TextBlock Text="UPN, nombre o email — pulsa Enter"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Users}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Visibility="{Binding Users.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="MouseDoubleClick" Handler="UserItem_DoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:UserSummary}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="16"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UserPrincipalName}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2"
                                                 Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0,4,0"
                                                 Fill="{Binding AccountEnabled, Converter={StaticResource BoolToBrushConverter}}"
                                                 ToolTip="{Binding AccountEnabled, Converter={StaticResource BoolToOnOffConverter}, ConverterParameter='Habilitado/Deshabilitado'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="8" Margin="8,0,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding SelectedUser.DisplayName, FallbackValue='Selecciona un usuario'}"
                               FontWeight="SemiBold"
                               FontSize="18"
                               Margin="0,0,0,8" />

                    <Grid Grid.Row="1" Margin="0,0,0,8"
                          Visibility="{Binding SelectedUser, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="UPN" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedUser.UserPrincipalName}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mail" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedUser.Mail}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cuenta" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedUser.AccountEnabled, Converter={StaticResource BoolToOnOffConverter}}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Licencias" Opacity="0.7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedUser.AssignedLicenseCount}" />
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="Habilitar"
                                       Margin="0,0,8,4"
                                       Command="{Binding EnableCommand}" />
                            <ui:Button Content="Deshabilitar"
                                       Margin="0,0,8,4"
                                       Command="{Binding DisableCommand}" />
                            <ui:Button Content="Quitar licencias"
                                       Margin="0,0,8,4"
                                       Command="{Binding RemoveLicensesCommand}" />
                            <ui:Button Content="Bulk CSV..."
                                       Margin="0,0,8,4"
                                       Command="{Binding ImportBulkCsvCommand}" />
                            <ui:Button Content="Exportar bulk..."
                                       Margin="0,0,8,4"
                                       Command="{Binding ExportBulkResultsCommand}" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Cargar SKUs"
                                       Margin="0,0,8,0"
                                       Command="{Binding LoadSkusCommand}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableSkus}"
                                      SelectedItem="{Binding SelectedSku}"
                                      DisplayMemberPath="Display"
                                      Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2"
                                       Content="Asignar licencia"
                                       Appearance="Primary"
                                       Command="{Binding AssignLicenseCommand}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.8" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Pertenece a" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Memberships}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GroupSummary}">
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Mail}" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding GroupKind}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
