<UserControl x:Class="Grex365.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:views="clr-namespace:Grex365.App.Views"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{l:L10n Key=Users.Eyebrow}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:L10n Key=Users.Title}"
                           Style="{StaticResource PageHeroTitle}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{l:L10n Key=Users.Action.BulkCsv}"
                           Margin="0,0,8,0"
                           Command="{Binding ImportBulkCsvCommand}" />
                <ui:Button Content="{l:L10n Key=Users.Action.ExportBulk}"
                           Command="{Binding ExportBulkResultsCommand}" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1"
                   Text="{l:L10n Key=Users.Subtitle}"
                   Style="{StaticResource PageSubtitleText}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{l:L10n Key=Users.Search.Label}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=Users.Search.Placeholder}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=Users.Search.Button}"
                                   Margin="8,0,0,0"
                                   Command="{Binding SearchCommand}" />
                        <ui:Button Grid.Column="2"
                                   Content="{l:L10n Key=Users.Search.Cancel}"
                                   Margin="8,0,0,0"
                                   Command="{Binding CancelCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <!-- Estado vacío: solo sin resultados Y sin búsqueda en curso (si no, skeleton) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                                <Condition Binding="{Binding Users.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{l:L10n Key=Users.Empty.Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{l:L10n Key=Users.Empty.Hint}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <!-- Skeleton mientras corre la búsqueda y aún no hay resultados -->
                        <ContentControl Margin="0,8,0,0" VerticalAlignment="Top">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource SkeletonListRows}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBusy}" Value="True" />
                                                <Condition Binding="{Binding Users.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <ListBox ItemsSource="{Binding Users}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Visibility="{Binding Users.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:UserSummary}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="16"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UserPrincipalName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2"
                                                 Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0,4,0"
                                                 Fill="{Binding AccountEnabled, Converter={StaticResource BoolToBrushConverter}}"
                                                 ToolTip="{Binding AccountEnabled, Converter={StaticResource BoolToOnOffConverter}, ConverterParameter='Status.Enabled/Status.Disabled'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="8,0,0,0">
                <Grid>
                    <!-- Rich detail panel — visible by default, populated on selection (1 click).
                         Same VM the Groups drawer reuses; ShowClose hidden since closing makes
                         no sense inline. The wrapper keeps the UsersViewModel DataContext so the
                         Visibility binds SelectedUser; the inner view's DataContext is the
                         UserDetailsViewModel it renders. -->
                    <ContentControl Visibility="{Binding SelectedUser, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <views:UserDetailsView DataContext="{Binding UserDetailsVm}"
                                               ShowClose="False" />
                    </ContentControl>

                    <!-- Empty-state: no user selected -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,24"
                                Visibility="{Binding SelectedUser, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=invert, FallbackValue=Visible}">
                        <TextBlock Text=""
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{l:L10n Key=Users.NoneSelected.Hint}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
