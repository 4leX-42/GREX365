<UserControl x:Class="Grex365.App.Views.UserDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             x:Name="Root"
             mc:Ignorable="d"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + close -->
        <Grid Grid.Row="0" Margin="24,20,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Detalle de usuario"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.55"
                           Margin="0,0,0,2" />
                <TextBlock Text="{Binding User.DisplayName, FallbackValue=—}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding User.UserPrincipalName, FallbackValue=—}"
                           Opacity="0.6"
                           FontSize="13"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="Cerrar"
                       VerticalAlignment="Top"
                       Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Status / busy -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,16,12">
            <ui:ProgressRing IsIndeterminate="True"
                             Width="14" Height="14"
                             Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Opacity="0.7"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Quick actions -->
        <WrapPanel Grid.Row="2"
                   Orientation="Horizontal"
                   Margin="24,0,16,16"
                   Visibility="{Binding HasUser, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <ui:Button Margin="0,0,8,8"
                       Command="{Binding ToggleAccountCommand}"
                       Content="Habilitar / Deshabilitar"
                       ToolTip="Cambia AccountEnabled del usuario" />
            <ui:Button Margin="0,0,8,8"
                       Command="{Binding RemoveAllLicensesCommand}"
                       Content="Quitar licencias"
                       ToolTip="Quita TODAS las licencias asignadas" />
        </WrapPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,0,16,16">
            <StackPanel>
                <!-- Identity card -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasUser, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="Identidad"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.55"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="UPN" Opacity="0.55" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding User.UserPrincipalName}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mail" Opacity="0.55" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding User.Mail, FallbackValue=—}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Estado" Opacity="0.55" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding User.AccountEnabled, Converter={StaticResource BoolToOnOffConverter}, ConverterParameter='Habilitado/Deshabilitado'}" FontSize="12" Margin="0,2" FontWeight="SemiBold" Foreground="{Binding User.AccountEnabled, Converter={StaticResource BoolToBrushConverter}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tipo" Opacity="0.55" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Margin="0,2">
                                <Run Text="{Binding User.IsGuest, Converter={StaticResource BoolToOnOffConverter}, ConverterParameter='Guest/Member', Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Licencias" Opacity="0.55" FontSize="12" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding User.AssignedLicenseCount, FallbackValue=0}" FontSize="12" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Licenses card -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasUser, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Licencias asignadas" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <TextBlock Grid.Column="1" FontSize="11" Opacity="0.5">
                                <Run Text="{Binding AssignedLicenses.Count, Mode=OneWay}" />
                                <Run Text=" total" />
                            </TextBlock>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AssignedLicenses}" MaxHeight="240">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding SkuPartNumber}" Style="{StaticResource MonoText}" FontSize="10" Opacity="0.45" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10" Opacity="0.55" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1"
                                                   Content="Quitar"
                                                   FontSize="11"
                                                   Padding="8,2"
                                                   Command="{Binding ElementName=Root, Path=DataContext.RemoveLicenseCommand}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,10,0,8" />

                        <TextBlock Text="Asignar nueva licencia" FontSize="11" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AssignableSkus}"
                                      SelectedItem="{Binding SelectedSkuToAdd}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SkuPartNumber}" FontSize="12" Opacity="0.7" Margin="0,0,8,0" />
                                            <TextBlock FontSize="11" Opacity="0.5">
                                                <Run Text="(" />
                                                <Run Text="{Binding Available, Mode=OneWay}" />
                                                <Run Text=" libres)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button Grid.Column="1"
                                       Content="Asignar"
                                       Margin="8,0,0,0"
                                       Command="{Binding AssignSelectedSkuCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Group memberships -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Visibility="{Binding HasUser, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pertenencias" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <TextBlock Grid.Column="1" FontSize="11" Opacity="0.5">
                                <Run Text="{Binding Memberships.Count, Mode=OneWay}" />
                                <Run Text=" grupos" />
                            </TextBlock>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Memberships}"
                                      MaxHeight="380">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupSummary}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Mail, FallbackValue=—}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="6,1"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding GroupKind}"
                                                       FontSize="10"
                                                       Opacity="0.7" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
