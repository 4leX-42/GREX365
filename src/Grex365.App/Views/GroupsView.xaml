<UserControl x:Class="Grex365.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:v="clr-namespace:Grex365.App.Views"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{l:L10n Key=Groups.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=Groups.Title}"
                       FontSize="28"
                       FontWeight="Light"
                       VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{l:L10n Key=Groups.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{l:L10n Key=Groups.Type.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton Content="{l:L10n Key=Groups.Type.Auto}"
                             IsChecked="{Binding BulkTypeChoice, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Auto}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             ToolTip="{l:L10n Key=Groups.Type.Auto.Tooltip}" />
                <RadioButton Content="{l:L10n Key=Groups.Type.M365}"
                             IsChecked="{Binding BulkTypeChoice, Converter={StaticResource StringEqualsConverter}, ConverterParameter=M365}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             ToolTip="{l:L10n Key=Groups.Type.M365.Tooltip}" />
                <RadioButton Content="{l:L10n Key=Groups.Type.DL}"
                             IsChecked="{Binding BulkTypeChoice, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DL}"
                             VerticalAlignment="Center"
                             ToolTip="{l:L10n Key=Groups.Type.DL.Tooltip}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{l:L10n Key=Groups.Domain.Label}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox Grid.Column="3"
                        Width="180"
                        Text="{Binding BulkDomain, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{l:L10n Key=Groups.Domain.Placeholder}" />
            <ui:Button Grid.Column="4"
                       Content="{l:L10n Key=Groups.Bulk.Create}"
                       Margin="8,0,0,0"
                       Command="{Binding BulkCreateFromCsvCommand}" />
            <ui:Button Grid.Column="5"
                       Content="{l:L10n Key=Groups.Bulk.ExportLog}"
                       Margin="8,0,0,0"
                       Command="{Binding ExportBulkCreateResultsCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Margin="0,0,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{l:L10n Key=Groups.Search.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=Groups.Search.Placeholder}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=Groups.Search.Button}"
                                   Margin="8,0,0,0"
                                   Command="{Binding SearchCommand}" />
                        <ui:ProgressRing IsIndeterminate="True"
                                         Grid.Column="1"
                                         Width="16" Height="16"
                                         Margin="0,0,8,0"
                                         HorizontalAlignment="Right"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,24"
                                    Visibility="{Binding Groups.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{l:L10n Key=Groups.Empty.Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{l:L10n Key=Groups.Empty.Hint}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <!-- Skeleton mientras corre la búsqueda y aún no hay resultados -->
                        <ContentControl Margin="0,8,0,0" VerticalAlignment="Top">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource SkeletonListRows}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBusy}" Value="True" />
                                                <Condition Binding="{Binding Groups.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <ListBox ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Visibility="{Binding Groups.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupSummary}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="6"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Mail, FallbackValue=—}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Padding="6,1"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding GroupKind}"
                                                       FontSize="10"
                                                       Opacity="0.75" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="8" Margin="8,0,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedGroup.DisplayName, FallbackValue={l:L10n Key=Groups.NoneSelected}, TargetNullValue={l:L10n Key=Groups.NoneSelected}}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                            <ui:Button Content="{l:L10n Key=Groups.RemoveSelected}"
                                       Margin="0,0,8,0"
                                       Command="{Binding RemoveSelectedMemberCommand}" />
                            <ui:Button Content="{l:L10n Key=Groups.ExportMembers}"
                                       Command="{Binding ExportMembersCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Empty-state: no group selected -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,24"
                                Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=invert, FallbackValue=Visible}">
                        <TextBlock Text=""
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{l:L10n Key=Groups.NoneSelected.Hint}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Members}"
                             SelectedItem="{Binding SelectedMember}"
                             Background="Transparent"
                             BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="MouseDoubleClick" Handler="MemberItem_DoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GroupMember}">
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName, FallbackValue=—}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Mail, FallbackValue=—}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,12,0,4"
                          Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{l:L10n Key=Groups.AddMembers.Label}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <v:UserPickerBox Grid.Column="1"
                                         MinWidth="160"
                                         Margin="12,0,8,0"
                                         VerticalAlignment="Center"
                                         Text="{Binding MemberToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Placeholder="{l:L10n Key=Groups.AddMembers.PickPlaceholder}" />
                        <ui:Button Grid.Column="2"
                                   Content="{l:L10n Key=Groups.AddMembers.PickButton}"
                                   Command="{Binding AddPickedMemberCommand}" />
                    </Grid>
                    <ui:TextBox Grid.Row="3"
                                Text="{Binding NewMembersText, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="80"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding SelectedGroup, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                        <ui:Button Content="{l:L10n Key=Groups.AddMembers.Button}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Command="{Binding AddMembersCommand}" />
                        <ui:Button Content="{l:L10n Key=Groups.Import.Button}"
                                   Margin="0,0,8,0"
                                   Command="{Binding ImportCsvCommand}" />
                        <ui:Button Content="{l:L10n Key=Groups.Export.Button}"
                                   Margin="0,0,8,0"
                                   Command="{Binding ExportResultsCommand}" />
                        <ui:Button Content="{l:L10n Key=Groups.Cancel.Button}"
                                   Margin="0,0,8,0"
                                   Command="{Binding CancelCommand}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3">
            <Border CornerRadius="8" Margin="0,12,0,0" Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding LastAddResults.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Groups.LastResults.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding LastAddResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AddMemberResult}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Input}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Margin="0,12,0,0" Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding BulkCreateResults.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Groups.BulkResults.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding BulkCreateResults}" MaxHeight="240">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BulkGroupResult}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GroupEmail}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding UserEmail, FallbackValue=—}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
