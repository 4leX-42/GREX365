<UserControl x:Class="Grex365.App.Views.OffboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:v="clr-namespace:Grex365.App.Views"
             xmlns:vm="clr-namespace:Grex365.App.ViewModels"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Status badge tint shared by candidate/target/step rows. -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#553B82F6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Background" Value="#5522C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ERROR">
                    <Setter Property="Background" Value="#55EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PENDIENTE">
                    <Setter Property="Background" Value="#55808080" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:L10n Key=Offboarding.Eyebrow}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:L10n Key=Offboarding.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:L10n Key=Offboarding.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: search + candidates + queue + options -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- Search (typeahead) -->
                    <Border CornerRadius="8" Padding="20" Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Offboarding.Search.Label}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8" />
                            <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="15"
                                        PlaceholderText="{l:L10n Key=Offboarding.Search.Placeholder}" />
                            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:UserSummary}">
                                        <Border CornerRadius="6" Padding="14,10" Margin="0,3"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding UserPrincipalName}" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Target.Add}"
                                                           FontSize="13" Padding="14,4" Appearance="Primary"
                                                           Command="{Binding DataContext.AddTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Candidates -->
                    <Border CornerRadius="8" Padding="20" Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:L10n Key=Offboarding.Candidates.Title}"
                                           FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Candidates.Find}"
                                           Margin="8,0,0,0" Command="{Binding FindCandidatesCommand}" />
                                <ui:Button Grid.Column="2" Content="{l:L10n Key=Offboarding.Candidates.AddAll}"
                                           Margin="8,0,0,0" Command="{Binding AddAllCandidatesCommand}"
                                           Visibility="{Binding Candidates.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Candidates}" MinHeight="120" MaxHeight="360">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OffboardingTarget}">
                                        <Border CornerRadius="6" Padding="14,11" Margin="0,3"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Upn}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Status}" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Target.Add}"
                                                           FontSize="13" Padding="14,4"
                                                           Command="{Binding DataContext.AddCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Queue (targets) -->
                    <Border CornerRadius="8" Padding="20" Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Offboarding.Targets.Title}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=Offboarding.Targets.Empty}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Targets.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OffboardingTarget}">
                                        <Border CornerRadius="8" Padding="14,12" Margin="0,4"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Upn}" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusBadge}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <ui:Button Grid.Row="0" Grid.Column="2" Content="{l:L10n Key=Offboarding.Target.Remove}"
                                                           FontSize="12" Padding="10,3"
                                                           Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <!-- Per-account delegate (this user's mailbox → X), with user autocomplete. Empty = default below / none. -->
                                                <v:UserPickerBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                                                 Text="{Binding DelegateTo, Mode=TwoWay}"
                                                                 Placeholder="{l:L10n Key=Offboarding.Target.DelegatePlaceholder}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Options + run -->
                    <Border CornerRadius="8" Padding="20"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.Disable}" IsChecked="{Binding DisableAccount}" FontSize="15" Margin="0,0,0,8" />
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.ConvertShared}" IsChecked="{Binding ConvertMailboxToShared}" FontSize="15" Margin="0,0,0,8" />
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.RemoveLicenses}" IsChecked="{Binding RemoveLicenses}" FontSize="15" />
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.DryRun}" IsChecked="{Binding DryRun}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" />

                            <TextBlock Text="{l:L10n Key=Offboarding.DelegateAll.Label}" FontWeight="SemiBold" FontSize="16" Margin="0,18,0,6" />
                            <v:UserPickerBox Text="{Binding DelegateToAll, Mode=TwoWay}"
                                             Placeholder="{l:L10n Key=Offboarding.Target.DelegatePlaceholder}" />

                            <CheckBox Content="{l:L10n Key=Offboarding.Option.ForwardToDelegate}" IsChecked="{Binding ForwardToDelegate}" FontSize="15" Margin="0,14,0,0" />
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.HideFromGal}" IsChecked="{Binding HideFromGal}" FontSize="15" Margin="0,8,0,0" />

                            <TextBlock Text="{l:L10n Key=Offboarding.AutoReply.Label}" FontWeight="SemiBold" FontSize="16" Margin="0,18,0,6" />
                            <TextBlock Text="{l:L10n Key=Offboarding.AutoReply.Template}" FontSize="14" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AutoReplyTemplates}"
                                      SelectedItem="{Binding SelectedAutoReplyTemplate, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      FontSize="15" Padding="10,7" Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch" />
                            <ui:TextBox Text="{Binding AutoReplyMessage, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="15" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110"
                                        VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="{l:L10n Key=Offboarding.AutoReply.Placeholder}" />
                            <TextBlock Text="{l:L10n Key=Offboarding.AutoReply.Hint}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <ui:Button Content="{l:L10n Key=Offboarding.Run.Batch}"
                                           Appearance="Primary" Margin="0,0,8,0" FontSize="15" Padding="18,9"
                                           Command="{Binding RunBatchCommand}" />
                                <ui:Button Content="{l:L10n Key=Offboarding.Cancel}"
                                           Margin="0,0,8,0" FontSize="15" Padding="14,9" Command="{Binding CancelCommand}" />
                                <ui:Button Content="{l:L10n Key=Offboarding.Export}"
                                           Margin="0,0,8,0" FontSize="15" Padding="14,9" Command="{Binding ExportResultsCommand}" />
                                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="8,0,8,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" FontSize="13" Opacity="0.85" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: live log console -->
            <Border Grid.Column="1" CornerRadius="8" Margin="8,0,0,0" Padding="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="14" Margin="0,0,8,0" Opacity="0.85" />
                            <TextBlock Text="{l:L10n Key=Offboarding.Log.Title}" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Log.Clear}"
                                   FontSize="11" Padding="10,2" Command="{Binding ClearLogCommand}" />
                    </Grid>
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding LiveLog}"
                             Background="#0D000000"
                             BorderThickness="0"
                             Margin="8,0,8,8"
                             SelectionMode="Extended"
                             ToolTip="Selecciona filas y Ctrl+C para copiar"
                             PreviewKeyDown="LogList_PreviewKeyDown"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogLine}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!-- INFO default -->
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="OK">
                                                        <Setter Property="Foreground" Value="#22C55E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="HEADER">
                                                        <Setter Property="Foreground" Value="#3B82F6" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
