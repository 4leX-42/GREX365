<UserControl x:Class="Grex365.App.Views.OffboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:vm="clr-namespace:Grex365.App.ViewModels"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Status badge tint shared by candidate/target/step rows. -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#553B82F6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Background" Value="#5522C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ERROR">
                    <Setter Property="Background" Value="#55EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PENDIENTE">
                    <Setter Property="Background" Value="#55808080" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:L10n Key=Offboarding.Eyebrow}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:L10n Key=Offboarding.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:L10n Key=Offboarding.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: search + candidates + queue + options -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- Search (typeahead) -->
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Offboarding.Search.Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{l:L10n Key=Offboarding.Search.Placeholder}" />
                            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:UserSummary}">
                                        <Border CornerRadius="6" Padding="10,6" Margin="0,2"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding UserPrincipalName}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Target.Add}"
                                                           FontSize="11" Padding="10,2"
                                                           Command="{Binding DataContext.AddTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Candidates -->
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:L10n Key=Offboarding.Candidates.Title}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Candidates.Find}"
                                           Margin="8,0,0,0" Command="{Binding FindCandidatesCommand}" />
                                <ui:Button Grid.Column="2" Content="{l:L10n Key=Offboarding.Candidates.AddAll}"
                                           Margin="8,0,0,0" Command="{Binding AddAllCandidatesCommand}"
                                           Visibility="{Binding Candidates.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Candidates}" MaxHeight="180">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OffboardingTarget}">
                                        <Border CornerRadius="6" Padding="10,6" Margin="0,2"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Upn}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Target.Add}"
                                                           FontSize="11" Padding="10,2"
                                                           Command="{Binding DataContext.AddCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Queue (targets) -->
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Offboarding.Targets.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=Offboarding.Targets.Empty}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Targets.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OffboardingTarget}">
                                        <Border CornerRadius="6" Padding="10,8" Margin="0,3"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Upn}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Text="{Binding DelegateTo, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="{l:L10n Key=Offboarding.Target.DelegatePlaceholder}" />
                                                <Border Grid.Column="2" Style="{StaticResource StatusBadge}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                                <ui:Button Grid.Column="3" Content="{l:L10n Key=Offboarding.Target.Remove}"
                                                           FontSize="11" Padding="8,2"
                                                           Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Options + run -->
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.Disable}" IsChecked="{Binding DisableAccount}" Margin="0,0,0,4" />
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.ConvertShared}" IsChecked="{Binding ConvertMailboxToShared}" Margin="0,0,0,4" />
                            <CheckBox Content="{l:L10n Key=Offboarding.Option.RemoveLicenses}" IsChecked="{Binding RemoveLicenses}" />

                            <TextBlock Text="{l:L10n Key=Offboarding.DelegateAll.Label}" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <ui:TextBox Text="{Binding DelegateToAll, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{l:L10n Key=Offboarding.Target.DelegatePlaceholder}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:Button Content="{l:L10n Key=Offboarding.Run.Batch}"
                                           Appearance="Primary" Margin="0,0,8,0"
                                           Command="{Binding RunBatchCommand}" />
                                <ui:Button Content="{l:L10n Key=Offboarding.Cancel}"
                                           Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="8,0,8,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" Opacity="0.85" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: live log console -->
            <Border Grid.Column="1" CornerRadius="8" Margin="8,0,0,0" Padding="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="14" Margin="0,0,8,0" Opacity="0.85" />
                            <TextBlock Text="{l:L10n Key=Offboarding.Log.Title}" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{l:L10n Key=Offboarding.Log.Clear}"
                                   FontSize="11" Padding="10,2" Command="{Binding ClearLogCommand}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding LiveLog}"
                             Background="#0D000000"
                             BorderThickness="0"
                             Margin="8,0,8,8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
