<UserControl x:Class="Grex365.App.Views.OffboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{l:L10n Key=Offboarding.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=Offboarding.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:L10n Key=Offboarding.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16" />

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Offboarding.Upn.Label}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Upn, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{l:L10n Key=Offboarding.Upn.Placeholder}"
                                Margin="0,0,0,12" />

                    <CheckBox Content="{l:L10n Key=Offboarding.Option.Disable}"
                              IsChecked="{Binding DisableAccount}"
                              Margin="0,0,0,4" />
                    <CheckBox Content="{l:L10n Key=Offboarding.Option.RemoveLicenses}"
                              IsChecked="{Binding RemoveLicenses}"
                              Margin="0,0,0,4" />
                    <CheckBox Content="{l:L10n Key=Offboarding.Option.ConvertShared}"
                              IsChecked="{Binding ConvertMailboxToShared}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Content="{l:L10n Key=Offboarding.Run}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Command="{Binding RunCommand}" />
                        <ui:Button Content="{l:L10n Key=Offboarding.Cancel}"
                                   Margin="0,0,8,0"
                                   Command="{Binding CancelCommand}" />
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="20" Height="20"
                                         Margin="8,0,8,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding Steps.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Offboarding.Steps.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OffboardingStep}">
                                <Border CornerRadius="6" Padding="12,9" Margin="0,3"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Status badge, colored by state -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#553B82F6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                                            <Setter Property="Background" Value="#5522C55E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ERROR">
                                                            <Setter Property="Background" Value="#55EF4444" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OMITIDO">
                                                            <Setter Property="Background" Value="#55F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
