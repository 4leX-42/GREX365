<UserControl x:Class="Grex365.App.Views.PsConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding RunCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer Style="{StaticResource PageRoot}">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="&#xE756;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="22"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Opacity="0.85" />
                <TextBlock Text="Consola PowerShell"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Ejecuta scripts arbitrarios en el runspace pool compartido. Útil para diagnóstico y comandos puntuales."
                       Style="{StaticResource PageSubtitleText}" />

            <Border Background="{DynamicResource BrushSemanticWarnSoft}"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushSemanticWarn}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource BrushSemanticWarn}"
                               Text="Sin sandbox. Los comandos se ejecutan con los privilegios de la sesión activa (incluyendo EXO y Graph si están conectados). Usa con cuidado." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Comando"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Get-Date"
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="13"
                                AcceptsReturn="True"
                                MinHeight="80"
                                MaxHeight="200"
                                VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Ejecutar"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   ToolTip="Ctrl+Enter"
                                   Command="{Binding RunCommand}" />
                        <ui:Button Content="Cancelar"
                                   Margin="0,0,8,0"
                                   ToolTip="Esc"
                                   Command="{Binding CancelCommand}" />
                        <ui:Button Content="Limpiar salida"
                                   Margin="0,0,16,0"
                                   Command="{Binding ClearCommand}" />
                        <ui:Button Content="↑"
                                   Margin="0,0,4,0"
                                   ToolTip="Comando anterior (historial)"
                                   Command="{Binding HistoryPrevCommand}" />
                        <ui:Button Content="↓"
                                   Margin="0,0,12,0"
                                   ToolTip="Comando siguiente (historial)"
                                   Command="{Binding HistoryNextCommand}" />
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="18" Height="18"
                                         Margin="0,0,8,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="14,10"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <TextBlock Text="Salida"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </Border>
                    <TextBox Text="{Binding OutputText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Mono,Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             MinHeight="260"
                             MaxHeight="500"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="14,10" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
