<UserControl x:Class="Grex365.App.Views.MailboxRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{l:L10n Key=MailboxRules.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=MailboxRules.Title}"
                           FontSize="28"
                           FontWeight="Light"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:L10n Key=MailboxRules.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16" />

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding Identity, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{l:L10n Key=MailboxRules.Identity.Placeholder}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1"
                               Content="{l:L10n Key=MailboxRules.Button.Load}"
                               Margin="8,0,0,0"
                               Command="{Binding LoadCommand}" />
                    <ui:ProgressRing Grid.Column="2"
                                     IsIndeterminate="True"
                                     Width="20" Height="20"
                                     Margin="8,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                </Grid>
            </Border>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding RulesLoaded, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=MailboxRules.AutoReply.Title}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{l:L10n Key=MailboxRules.AutoReply.StateLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AutoReplyStates}"
                                  SelectedItem="{Binding AutoReplyState}"
                                  Width="160" />
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{l:L10n Key=MailboxRules.AutoReply.InternalMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding InternalMessage, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="100"
                                        VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{l:L10n Key=MailboxRules.AutoReply.ExternalMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ExternalMessage, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="100"
                                        VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{l:L10n Key=MailboxRules.AutoReply.StartTime}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding StartTime}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{l:L10n Key=MailboxRules.AutoReply.EndTime}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding EndTime}" />
                        </StackPanel>
                    </Grid>

                    <ui:Button Content="{l:L10n Key=MailboxRules.AutoReply.Apply}"
                               Appearance="Primary"
                               Command="{Binding ApplyAutoReplyCommand}"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding RulesLoaded, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=MailboxRules.Forwarding.Title}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CurrentForwardingDisplay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding ForwardingSmtp, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=MailboxRules.Forwarding.Placeholder}" />
                        <CheckBox Grid.Column="1"
                                  Content="{l:L10n Key=MailboxRules.Forwarding.DeliverBoth}"
                                  IsChecked="{Binding DeliverToMailboxAndForward}"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{l:L10n Key=MailboxRules.Forwarding.Apply}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Command="{Binding ApplyForwardingCommand}" />
                        <ui:Button Content="{l:L10n Key=MailboxRules.Forwarding.Clear}"
                                   Command="{Binding ClearForwardingCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding RulesLoaded, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=MailboxRules.Calendar.Title}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding CalendarPrincipal, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{l:L10n Key=MailboxRules.Calendar.Principal.Placeholder}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CalendarAccessOptions}"
                                  SelectedItem="{Binding CalendarAccess}"
                                  Margin="8,0,0,0" />
                        <ui:Button Grid.Column="2"
                                   Content="{l:L10n Key=MailboxRules.Calendar.ApplyUpdate}"
                                   Appearance="Primary"
                                   Margin="8,0,0,0"
                                   Command="{Binding ApplyCalendarPermissionCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{l:L10n Key=MailboxRules.Calendar.CurrentPermissions}"
                                   FontWeight="SemiBold"
                                   Opacity="0.8" />
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=MailboxRules.Calendar.RemoveSelected}"
                                   Command="{Binding RemoveCalendarPermissionCommand}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding CalendarPermissions}"
                             SelectedItem="{Binding SelectedCalendarPermission}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CalendarPermissionEntry}">
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Principal}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AccessRights}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
