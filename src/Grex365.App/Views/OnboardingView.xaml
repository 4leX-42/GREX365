<UserControl x:Class="Grex365.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:v="clr-namespace:Grex365.App.Views"
             xmlns:models="clr-namespace:Grex365.Core.Models;assembly=Grex365.Core"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{l:L10n Key=Onboarding.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=Onboarding.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:L10n Key=Onboarding.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16" />

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:L10n Key=Onboarding.Field.DisplayName}" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,0,8" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:L10n Key=Onboarding.Field.DisplayName.Placeholder}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{l:L10n Key=Onboarding.Field.Upn}" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,0,8" />
                    <ui:TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Upn, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:L10n Key=Onboarding.Field.Upn.Placeholder}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:L10n Key=Onboarding.Field.Alias}" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,0,8" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MailNickname, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:L10n Key=Onboarding.Field.Alias.Placeholder}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{l:L10n Key=Onboarding.Field.UsageLocation}" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,0,8" />
                    <ui:TextBox Grid.Row="1" Grid.Column="4" Text="{Binding UsageLocation, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:L10n Key=Onboarding.Field.Password}" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,0,8" />
                    <ui:PasswordBox Grid.Row="2" Grid.Column="1" Password="{Binding InitialPassword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:L10n Key=Onboarding.Field.Password.Placeholder}" Margin="0,0,0,8" />
                    <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                              Content="{l:L10n Key=Onboarding.Field.ForceChange}"
                              IsChecked="{Binding ForceChangePassword}"
                              VerticalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:L10n Key=Onboarding.Field.Skus}" VerticalAlignment="Center" Opacity="0.8" Margin="0,8,0,8" />
                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="{l:L10n Key=Onboarding.Button.LoadSkus}" Command="{Binding LoadSkusCommand}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableSkus}"
                                  SelectedItem="{Binding SelectedSku}"
                                  DisplayMemberPath="Display"
                                  Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="{l:L10n Key=Onboarding.Button.AddSku}" Command="{Binding AddSelectedSkuCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:L10n Key=Onboarding.Field.SkusToAssign}" VerticalAlignment="Top" Opacity="0.8" Margin="0,4,0,8" />
                    <ItemsControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                  ItemsSource="{Binding SelectedSkus}"
                                  Margin="0,4,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SkuInfo}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Display}" />
                                    <ui:Button Grid.Column="1"
                                               Content="{l:L10n Key=Onboarding.Button.RemoveSku}"
                                               Command="{Binding DataContext.RemoveSkuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{l:L10n Key=Onboarding.Field.Groups}" VerticalAlignment="Top" Opacity="0.8" Margin="0,4,0,0" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <v:GroupPickerBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Text="{Binding GroupToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Placeholder="{l:L10n Key=Onboarding.Field.Groups.PickPlaceholder}" />
                            <ui:Button Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Content="{l:L10n Key=Onboarding.Field.Groups.PickButton}"
                                       Command="{Binding AddPickedGroupCommand}" />
                        </Grid>
                        <ui:TextBox Text="{Binding GroupsText, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="80"
                                    VerticalScrollBarVisibility="Auto"
                                    PlaceholderText="{l:L10n Key=Onboarding.Field.Groups.Placeholder}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:L10n Key=Onboarding.Button.Run}"
                               Appearance="Primary"
                               Margin="0,0,8,0"
                               Command="{Binding RunCommand}" />
                    <ui:Button Content="{l:L10n Key=Onboarding.Button.Cancel}"
                               Margin="0,0,8,0"
                               Command="{Binding CancelCommand}" />
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="20" Height="20"
                                     Margin="8,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"
                               Opacity="0.8" />
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding Steps.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=Onboarding.Steps.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OnboardingStep}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
