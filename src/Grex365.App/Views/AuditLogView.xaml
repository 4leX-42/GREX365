<UserControl x:Class="Grex365.App.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             xmlns:abs="clr-namespace:Grex365.Core.Abstractions;assembly=Grex365.Core"
             mc:Ignorable="d">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{l:L10n Key=AuditLog.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=AuditLog.Title}" Style="{StaticResource PageHeroTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="{l:L10n Key=AuditLog.Subtitle}"
                   Style="{StaticResource PageSubtitleText}" />

        <Border Grid.Row="2"
                Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                Visibility="{Binding Summary, Converter={StaticResource NullToCollapsedConverter}}">
            <StackPanel>
                <TextBlock Text="{l:L10n Key=AuditLog.Metrics.Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <WrapPanel>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=AuditLog.Metric.Total}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Summary.TotalCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=AuditLog.Metric.Ok}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Summary.OkCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushSemanticOk}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=AuditLog.Metric.Warn}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Summary.WarnCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushSemanticWarn}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=AuditLog.Metric.Error}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Summary.ErrorCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushSemanticError}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=AuditLog.Metric.Last24h}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Summary.Last24hCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,8,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=AuditLog.Metric.ErrorRate}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Summary.ErrorRate, StringFormat=P1}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{l:L10n Key=AuditLog.TopSources}" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Summary.TopSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Source}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" Opacity="0.85" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:L10n Key=AuditLog.RecentErrors}" FontWeight="SemiBold" FontSize="12" Opacity="0.85" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Summary.RecentErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{l:L10n Key=AuditLog.Month.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding Month}" Width="160" Margin="0,0,8,0" />
                <ui:Button Grid.Column="2" Content="{l:L10n Key=AuditLog.Load}" Command="{Binding LoadCommand}" Appearance="Primary" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{l:L10n Key=AuditLog.SourceFilter.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <ui:TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" PlaceholderText="{l:L10n Key=AuditLog.SourceFilter.Placeholder}" />
                    <TextBlock Text="{l:L10n Key=AuditLog.OutcomeFilter.Label}" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.8" />
                    <ui:TextBox Text="{Binding OutcomeFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" PlaceholderText="{l:L10n Key=AuditLog.OutcomeFilter.Placeholder}" />
                </StackPanel>

                <ui:Button Grid.Column="4" Content="{l:L10n Key=AuditLog.OpenFolder}" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
                <ui:ProgressRing Grid.Column="5" IsIndeterminate="True" Width="20" Height="20" Margin="8,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="12,8" Opacity="0.8" Text="{Binding StatusMessage}" />
                <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                        <Condition Binding="{Binding Filtered.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE81C;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{l:L10n Key=AuditLog.Empty.Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{l:L10n Key=AuditLog.Empty.Hint}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Filtered}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:L10n Key=AuditLog.Column.Timestamp}" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" ElementStyle="{StaticResource DataMonoCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=AuditLog.Column.Actor}"     Binding="{Binding Actor}"                                       Width="120" ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=AuditLog.Column.Source}"    Binding="{Binding Source}"                                      Width="120" ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=AuditLog.Column.Outcome}"   Binding="{Binding Outcome}"                                     Width="80"  ElementStyle="{StaticResource DataCellText}" />
                        <DataGridTextColumn Header="{l:L10n Key=AuditLog.Column.Message}"   Binding="{Binding Message}"                                     Width="*"   ElementStyle="{StaticResource DataCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
