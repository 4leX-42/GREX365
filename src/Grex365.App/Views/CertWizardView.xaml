<UserControl x:Class="Grex365.App.Views.CertWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Grex365.App.Xaml"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{l:L10n Key=CertWizard.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:L10n Key=CertWizard.Title}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
        </StackPanel>
            <TextBlock Text="{l:L10n Key=CertWizard.Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16" />

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=CertWizard.Field.CommonName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding CommonName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{l:L10n Key=CertWizard.Field.CommonName.Placeholder}"
                                Margin="0,0,0,12" />

                    <TextBlock Text="{l:L10n Key=CertWizard.Field.ValidDays}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding ValidDays, UpdateSourceTrigger=PropertyChanged}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12" />

                    <TextBlock Text="{l:L10n Key=CertWizard.Field.ExportDir}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1"
                                   Content="{l:L10n Key=CertWizard.Button.Browse}"
                                   Margin="8,0,0,0"
                                   Command="{Binding BrowseExportFolderCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{l:L10n Key=CertWizard.Button.Generate}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Command="{Binding GenerateCommand}" />
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="20" Height="20"
                                         Margin="0,0,8,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding Generated, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{l:L10n Key=CertWizard.Result}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:L10n Key=CertWizard.Field.Subject}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Generated.Subject}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:L10n Key=CertWizard.Field.Thumbprint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Generated.Thumbprint}"
                                   FontFamily="Cascadia Mono,Consolas"
                                   FontWeight="Bold"
                                   IsHitTestVisible="True"
                                   Cursor="IBeam" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:L10n Key=CertWizard.Field.ValidFrom}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Generated.NotBefore, StringFormat='yyyy-MM-dd HH:mm'}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:L10n Key=CertWizard.Field.ValidTo}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Generated.NotAfter, StringFormat='yyyy-MM-dd HH:mm'}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:L10n Key=CertWizard.Field.CerPath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Generated.CerPath}" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="{l:L10n Key=CertWizard.Button.OpenFolder}"
                                   Margin="0,0,8,0"
                                   Command="{Binding OpenExportFolderCommand}" />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=CertWizard.Pfx.Title}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=CertWizard.Pfx.Hint}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=CertWizard.Pfx.PathLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding PfxPath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{l:L10n Key=CertWizard.Pfx.PathPlaceholder}"
                                        Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=CertWizard.Pfx.PasswordLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <PasswordBox x:Name="PfxPasswordBox"
                                         Width="280"
                                         HorizontalAlignment="Left"
                                         Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{l:L10n Key=CertWizard.Pfx.Button.Export}"
                                           Margin="0,0,8,0"
                                           Click="ExportPfx_Click" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding PfxStatus}"
                                           Opacity="0.85" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=CertWizard.AppReg.Title}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=CertWizard.AppReg.Hint}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=CertWizard.AppReg.DisplayName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding AppRegDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{l:L10n Key=CertWizard.AppReg.DisplayName.Placeholder}"
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:Button Content="{l:L10n Key=CertWizard.AppReg.Button.Create}"
                                           Appearance="Primary"
                                           Margin="0,0,8,0"
                                           Command="{Binding CreateAppRegistrationCommand}" />
                                <ui:Button Content="{l:L10n Key=CertWizard.AppReg.Button.Consent}"
                                           Margin="0,0,8,0"
                                           Command="{Binding OpenAdminConsentCommand}"
                                           Visibility="{Binding AppRegResult, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AppRegStatus}" Opacity="0.85" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=CertWizard.NextSteps}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{l:L10n Key=CertWizard.NextSteps.Body}"
                                       TextWrapping="Wrap"
                                       Opacity="0.85" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
