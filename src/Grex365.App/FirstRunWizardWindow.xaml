<ui:FluentWindow x:Class="Grex365.App.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Grex365.App"
        xmlns:vm="clr-namespace:Grex365.App.ViewModels"
        mc:Ignorable="d"
        Title="Bienvenido a GREX365"
        Height="640" Width="780"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Configuración inicial" />

        <!-- Step indicator -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsWelcome, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="1 Bienvenida" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsConnection, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="2 Conexión" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsTenantLock, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="3 Tenant lock" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsTheme, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="4 Tema" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsSummary, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="5 Resumen" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <!-- Pages -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="40,8,40,16">
            <Grid>
                <!-- Page 1: Welcome -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Welcome}">
                    <TextBlock Text="&#xE703;" FontFamily="{StaticResource IconFontFamily}" FontSize="56"
                               HorizontalAlignment="Center" Margin="0,8,0,16"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Bienvenido a GREX365" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Opacity="0.85"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Toolkit administrativo para Microsoft 365. Este asistente te guía por la configuración inicial mínima para empezar a operar." />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Qué configurarás" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="• Método de conexión (device code o certificado)" Margin="0,0,0,4" />
                            <TextBlock Text="• Tenant lock (opcional, previene conectar a tenant equivocado)" Margin="0,0,0,4" />
                            <TextBlock Text="• Tema visual (claro u oscuro)" />
                        </StackPanel>
                    </Border>
                    <TextBlock TextAlignment="Center" Margin="0,16,0,0" Opacity="0.6" FontSize="12"
                               Text="Puedes saltar el asistente y configurar todo después en Ajustes." />
                </StackPanel>

                <!-- Page 2: Connection -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Connection}">
                    <TextBlock Text="Método de conexión" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="Cómo se autenticará la app contra Microsoft Graph y Exchange Online." />

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <RadioButton GroupName="ConnMethod"
                                         IsChecked="{Binding ConnectionMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=devicecode}"
                                         Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Device code (recomendado primera vez)" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.75" FontSize="12"
                                               Text="Inicia sesión interactiva con tu cuenta admin Microsoft. No requiere App Registration. Ideal para descubrir + crear el cert via Asistente." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="ConnMethod"
                                         IsChecked="{Binding ConnectionMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=cert}">
                                <StackPanel>
                                    <TextBlock Text="Certificado (app-only)" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.75" FontSize="12"
                                               Text="Autenticación no interactiva con cert X.509 + App Registration. Requiere setup previo (puedes hacerlo después desde Asistente cert)." />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 3: Tenant lock -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TenantLock}">
                    <TextBlock Text="Tenant lock (opcional)" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="Si gestionas varios tenants, activa el lock para evitar conectar accidentalmente a uno equivocado." />

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <CheckBox Content="Activar tenant lock"
                                      IsChecked="{Binding EnforceTenantLock}"
                                      FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Tenant ID esperado" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       IsEnabled="{Binding EnforceTenantLock}" />
                            <ui:TextBox Text="{Binding ExpectedTenantId, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding EnforceTenantLock}"
                                        PlaceholderText="00000000-0000-0000-0000-000000000000"
                                        Margin="0,0,0,12" />
                            <TextBlock Text="Dominio esperado" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       IsEnabled="{Binding EnforceTenantLock}" />
                            <ui:TextBox Text="{Binding ExpectedTenantDomain, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding EnforceTenantLock}"
                                        PlaceholderText="contoso.onmicrosoft.com" />
                            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.6" FontSize="11"
                                       Text="Si el TenantId real al conectar no coincide, la conexión se aborta automáticamente." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 4: Theme -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Theme}">
                    <TextBlock Text="Tema" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="Puedes cambiarlo después en cualquier momento desde el botón Tema en la barra lateral." />

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <RadioButton GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dark}"
                                         Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Oscuro" FontWeight="SemiBold" />
                                    <TextBlock Text="Mica oscuro, recomendado en sesiones largas." Margin="0,4,0,0" Opacity="0.75" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Light}"
                                         Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Claro" FontWeight="SemiBold" />
                                    <TextBlock Text="Mica claro, mejor en entornos muy iluminados." Margin="0,4,0,0" Opacity="0.75" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Auto}">
                                <StackPanel>
                                    <TextBlock Text="Auto (seguir sistema)" FontWeight="SemiBold" />
                                    <TextBlock Text="Lee la preferencia AppsUseLightTheme del registro de Windows y se actualiza al instante cuando cambia." Margin="0,4,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 5: Summary -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Summary}">
                    <TextBlock Text="Resumen" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="Pulsa Finalizar para guardar. Puedes ajustar cualquier valor después en Ajustes." />

                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Conexión:" Opacity="0.7" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionMethodLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant lock:" Opacity="0.7" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantLockLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tema:" Opacity="0.7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Theme}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,16,0,0" Text="{Binding SaveStatus}" Opacity="0.8" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="3"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Saltar wizard"
                           Command="{Binding SkipCommand}"
                           Click="Close_Click" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Atrás"
                               Margin="0,0,8,0"
                               Command="{Binding BackCommand}" />
                    <ui:Button Content="Siguiente"
                               Appearance="Primary"
                               Margin="0,0,8,0"
                               Command="{Binding NextCommand}"
                               Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="Finalizar"
                               Appearance="Primary"
                               Click="Finish_Click"
                               Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
