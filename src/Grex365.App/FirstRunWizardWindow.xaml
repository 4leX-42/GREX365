<ui:FluentWindow x:Class="Grex365.App.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Grex365.App"
        xmlns:vm="clr-namespace:Grex365.App.ViewModels"
        xmlns:l="clr-namespace:Grex365.App.Xaml"
        mc:Ignorable="d"
        Title="{l:L10n Key=Wizard.Window.Title}"
        Height="640" Width="780"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:L10n Key=Wizard.TitleBar}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsWelcome, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="{l:L10n Key=Wizard.Step.Welcome}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsConnection, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="{l:L10n Key=Wizard.Step.Connection}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsTenantLock, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="{l:L10n Key=Wizard.Step.TenantLock}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsTheme, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="{l:L10n Key=Wizard.Step.Theme}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="14" Padding="10,5" Margin="3,0"
                    Background="{Binding IsSummary, Converter={StaticResource BoolToBrushConverter}}">
                <TextBlock Text="{l:L10n Key=Wizard.Step.Summary}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="40,8,40,16">
            <Grid>
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Welcome}">
                    <TextBlock Text="&#xE703;" FontFamily="{StaticResource IconFontFamily}" FontSize="56"
                               HorizontalAlignment="Center" Margin="0,8,0,16"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:L10n Key=Wizard.Welcome.Title}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Opacity="0.85"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{l:L10n Key=Wizard.Welcome.Subtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{l:L10n Key=Wizard.Welcome.SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{l:L10n Key=Wizard.Welcome.Bullet1}" Margin="0,0,0,4" />
                            <TextBlock Text="{l:L10n Key=Wizard.Welcome.Bullet2}" Margin="0,0,0,4" />
                            <TextBlock Text="{l:L10n Key=Wizard.Welcome.Bullet3}" />
                        </StackPanel>
                    </Border>
                    <TextBlock TextAlignment="Center" Margin="0,16,0,0" Opacity="0.6" FontSize="12"
                               Text="{l:L10n Key=Wizard.Welcome.SkipHint}" />
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Connection}">
                    <TextBlock Text="{l:L10n Key=Wizard.Connection.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="{l:L10n Key=Wizard.Connection.Subtitle}" />

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <RadioButton GroupName="ConnMethod"
                                         IsChecked="{Binding ConnectionMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=devicecode}"
                                         Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{l:L10n Key=Wizard.Connection.DeviceCode}" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.75" FontSize="12"
                                               Text="{l:L10n Key=Wizard.Connection.DeviceCode.Hint}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="ConnMethod"
                                         IsChecked="{Binding ConnectionMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=cert}">
                                <StackPanel>
                                    <TextBlock Text="{l:L10n Key=Wizard.Connection.Cert}" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.75" FontSize="12"
                                               Text="{l:L10n Key=Wizard.Connection.Cert.Hint}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TenantLock}">
                    <TextBlock Text="{l:L10n Key=Wizard.TenantLock.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="{l:L10n Key=Wizard.TenantLock.Subtitle}" />

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <CheckBox Content="{l:L10n Key=Wizard.TenantLock.Enable}"
                                      IsChecked="{Binding EnforceTenantLock}"
                                      FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="{l:L10n Key=Wizard.TenantLock.IdLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       IsEnabled="{Binding EnforceTenantLock}" />
                            <ui:TextBox Text="{Binding ExpectedTenantId, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding EnforceTenantLock}"
                                        PlaceholderText="{l:L10n Key=Settings.Tenant.IdPlaceholder}"
                                        Margin="0,0,0,12" />
                            <TextBlock Text="{l:L10n Key=Wizard.TenantLock.DomainLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       IsEnabled="{Binding EnforceTenantLock}" />
                            <ui:TextBox Text="{Binding ExpectedTenantDomain, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding EnforceTenantLock}"
                                        PlaceholderText="{l:L10n Key=Settings.Tenant.DomainPlaceholder}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.6" FontSize="11"
                                       Text="{l:L10n Key=Wizard.TenantLock.Hint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Theme}">
                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="{l:L10n Key=Wizard.Theme.Subtitle}" />

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <RadioButton GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dark}"
                                         Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Dark}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Dark.Hint}" Margin="0,4,0,0" Opacity="0.75" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Light}"
                                         Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Light}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Light.Hint}" Margin="0,4,0,0" Opacity="0.75" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Auto}">
                                <StackPanel>
                                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Auto}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:L10n Key=Wizard.Theme.Auto.Hint}" Margin="0,4,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Summary}">
                    <TextBlock Text="{l:L10n Key=Wizard.Summary.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="{l:L10n Key=Wizard.Summary.Subtitle}" />

                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:L10n Key=Wizard.Summary.Connection}" Opacity="0.7" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionMethodLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:L10n Key=Wizard.Summary.TenantLock}" Opacity="0.7" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantLockLabel}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:L10n Key=Wizard.Summary.Theme}" Opacity="0.7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Theme}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,16,0,0" Text="{Binding SaveStatus}" Opacity="0.8" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{l:L10n Key=Wizard.Button.Skip}"
                           Command="{Binding SkipCommand}"
                           Click="Close_Click" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="{l:L10n Key=Common.Back}"
                               Margin="0,0,8,0"
                               Command="{Binding BackCommand}" />
                    <ui:Button Content="{l:L10n Key=Common.Next}"
                               Appearance="Primary"
                               Margin="0,0,8,0"
                               Command="{Binding NextCommand}"
                               Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="{l:L10n Key=Common.Finish}"
                               Appearance="Primary"
                               Click="Finish_Click"
                               Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
